# AthenaK input file for Task E2 unit test: origin (r=0) ghost-zone sign-flip and
# Area1(is)=0 checks, spherical_polar (1D radial).

<comment>
problem   = origin conservation unit test (spherical, 1D radial)

<job>
basename  = ut_origin_conservation_spherical

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = reflect
ox1_bc    = outflow

nx2       = 1
x2min     = 0.0
x2max     = 3.14159265358979324
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 16
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = 5
tlim       = 1.0e10

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = origin_conservation_test
dens      = 1.0
pgas      = 1.0
vr0       = 0.2
vt0       = 0.15
vp0       = 0.1
