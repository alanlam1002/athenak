# AthenaK input file for Task A3 unit test: mass conservation under the new generic
# area/volume-weighted flux-divergence kernel (src/hydro/hydro_update.cpp).
#
# Fully periodic, single-level (no AMR, so restriction/prolongation -- which this task
# does not touch -- never fires), smooth linear-wave perturbation. On a periodic domain,
# Sum_cells Vol*divF telescopes to the boundary-flux residual, which is exactly zero for
# a closed/periodic domain (interior-face contributions cancel pairwise; there is no true
# domain boundary). Total mass (tracked by the existing <output> file_type=hst "mass"
# column) must therefore be conserved to roundoff over the run, regardless of the
# (smooth, physically evolving) flux values themselves -- this is a strong, physically
# meaningful realization of the "conservation telescoping" check without needing a
# synthetic/injected flux field.

<comment>
problem   = hydro linear wave (mass-conservation unit test)

<job>
basename  = ut_hydro_mass_conservation

<mesh>
nghost    = 2
coord     = cartesian
nx1       = 16
x1min     = 0.0
x1max     = 3.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 1.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 8
x3min     = 0.0
x3max     = 1.5
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.1
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667
iso_sound_speed = 1.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
along_x1  = false
along_x2  = false
along_x3  = false

<output1>
file_type = hst
dt        = 0.01
