# Scalarized-neutron-star (RNS-ST) test: single polytrope EOS (K=100, Gamma=2, code
# units), J=0 (non-rotating), omega_c(=paper's B)=12, mphi=0.01 (mass2=mphi^2=0.0001).
# ID file: Gam2_K100_J.00_Mb1.338_B1.20E+01_mphi1.00E-02_rhoc7.168E+14_sphim.316.dat
# Domain/resolution/gauge/BCs copied verbatim from the already-working
# rns_st_mpa1.athinput (first, low-res MPA1 test) -- this is a first look at a second,
# independent star (different EOS, much weaker scalar coupling) before any
# resolution-convergence question is on the table for this configuration.

<comment>
problem  = Scalarized NS (RNS-ST/Gam2_K100), Z4c-evolved

<job>
basename = rns_st_gam2k100

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 64      # number of cells in x1-direction
x1min  = 0.0
x1max  = 102.4
ix1_bc = reflect
ox1_bc = diode

nx2    = 64
x2min  = 0.0
x2max  = 102.4
ix2_bc = reflect
ox2_bc = diode

nx3    = 64
x3min  = 0.0
x3max  = 102.4
ix3_bc = reflect
ox3_bc = diode

<meshblock>
nx1  = 32
nx2  = 32
nx3  = 32

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.4
nlim       = 30
tlim       = 10000
ndiag      = 1

<coord>
general_rel = true
m           = 1.0
a           = 0.0
excise      = false

<mhd>
eos         = ideal          # placeholder (unused, required by parser)
gamma       = 2.0            # ratio of specific heats Gamma (also used by
                              # tov::PolytropeEOS below -- P = kappa*rho^gamma)

dyn_eos     = ideal          # PrimitiveSolver EOSPolicy -- single polytrope, matches
                              # this RNS-ST ID's EOS (K=100, Gamma=2, code units)
dyn_error   = reset_floor
reconstruct = ppmx
rsolver     = hlle
dfloor      = 1.0e-13
tfloor      = 1.0e-12
dthreshold  = 1.02
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<z4c>
# 1+log lapse
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0

# Gamma-driver shift
shift_eta       = 0.3
shift_advect    = 1.0

# Kreiss-Oliger dissipation
diss            = 0.5
chi_div_floor   = 1e-05

# Constraint damping (Z4c)
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
id_file     = /sakura/ptmp/tlam/initial/rns_new/Gam2_K100_J.00_Mb1.338_B1.20E+01_mphi1.00E-02_rhoc7.168E+14_sphim.316.dat
user_hist   = true
kappa       = 100.0    # P = kappa*rho^gamma (tov::PolytropeEOS)

<scalarfield>
omega_c   = 12.0     # "B" in the filename / paper's notation
beta0     = 1.0      # hardcoded throughout this module -- not independently free
mass2     = 0.0001    # mphi=0.01 -> mass2 = mphi^2
sphi0     = 0.0
diss      = 0.5

<output1>
file_type   = hst
dt          = 0.00001
data_format = %20.15e

<output2>
file_type   = bin
variable    = scalarfield
dt          = 5.0
