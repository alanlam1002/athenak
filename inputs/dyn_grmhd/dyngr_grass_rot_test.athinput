# AthenaK input file: smoke test for dyngr_grass pgen, non-rotating GRASS restart

<comment>
problem   = GRASS-initial-data neutron star (non-rotating smoke test)

<job>
basename  = grass_rot_smoke

<mesh>
nghost     = 3        # Number of ghost cells
nx1        = 32       # Number of zones in X1-direction
x1min      = -24      # minimum value of X1 (code units, ~ a few stellar radii)
x1max      =  24      # maximum value of X1
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 32
x2min      = -24
x2max      =  24
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 32
x3min      = -24
x3max      =  24
ix3_bc     = outflow
ox3_bc     = outflow

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.25
nlim       = 0        # just build initial data + constraints, no evolution steps
tlim       = 1000
ndiag      = 1

<coord>
general_rel = true
excise      = false
m           = 0.0
a           = 0.0

<mhd>
eos         = ideal
gamma       = 2.0
dyn_eos     = ideal
dyn_error   = reset_floor
reconstruct = ppmx
rsolver     = hlle
dfloor      = 1.0e-13
tfloor      = 1.0e-10
dthreshold  = 1.02
dyn_scratch = 1
fofc        = false
enforce_maximum = false

<adm>

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 0.3
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1e-05
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
id_file         = /tmp/claude-38120/-sakura-u-tlam/babac08b-239a-4765-9a8d-357a4e942af6/scratchpad/res_default_r085_lam128072.rst
grass_eos_table = /u/tlam/GRASS/eos/DD2_hot_equal_pinned.dat
user_hist       = true

<output1>
file_type   = hst
dt          = 1.0

<output2>
file_type   = bin
variable    = mhd_w
dt          = 1000.0
slice_x3    = 0.0

<output3>
file_type   = bin
variable    = adm
dt          = 1000.0
slice_x3    = 0.0
