# Athena++ (Kokkos version) input file for TOV star: bitant + AMR + restart repro
#
# Cheap repro for a NaN crash observed in a bitant (x3min=0, ix3_bc=reflect) BNS
# production run with AMR: restarting from a checkpoint produced NaN in conserved
# variables AND the metric at a ghost cell near the z=0 reflecting boundary,
# immediately (before cycle 1). An identical full-domain (non-bitant) run stayed
# clean. This input isolates "reflect BC + AMR level boundary + restart" using a
# single TOV star instead of the full BNS/tabulated-EOS setup.
#
# A small fixed refined region around the star (x3 in [0,10], overlapping the
# z=0 physical boundary) forces an AMR level interface to coincide with the
# reflecting boundary, mirroring the production parfile's <refined_region1>.

<comment>
problem  = Unmagnetized TOV star (bitant + AMR restart repro)

<job>
basename = tov_bitant

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 64      # number of cells in x1-direction
x1min  = -51.2   # minimum x1
x1max  =  51.2   # maximum x1
ix1_bc = diode   # inner boundary
ox1_bc = diode   # outer boundary

nx2    = 64      # number of cells in x2-direction
x2min  = -51.2   # minimum x2
x2max  =  51.2   # maximum x2
ix2_bc = diode   # inner boundary
ox2_bc = diode   # outer boundary

nx3    = 32      # number of cells in x3-direction
x3min  = 0.0     # minimum x3 -- bitant
x3max  = 51.2    # maximum x3
ix3_bc = reflect # inner boundary -- bitant symmetry plane
ox3_bc = diode   # outer boundary

<meshblock>
nx1  = 16        # Number of cells in each MeshBlock, X1-dir
nx2  = 16        # Number of cells in each MeshBlock, X2-dir
nx3  = 16        # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement          = adaptive
max_nmb_per_rank    = 600
num_levels          = 3
refinement_interval = 1

<amr_criterion0>
method = user

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = 30
tlim       = 10000
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false

<mhd>
eos         = ideal     # EOS type
dyn_eos     = ideal     # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx      # spatial reconstruction method
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.0e-10   # floor on density rho
tfloor      = 1.0e-8
dthreshold  = 1.02      # Threshold for flooring
gamma       = 2.0       # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<z4c_amr>
# chi-threshold refinement: chi near the stellar surface should cross
# chi_min, actively triggering refine/derefine (unlike a static
# refined_region, which only seeds the mesh once at t=0 and never
# changes it again).
method  = chi
chi_min = 0.95

<z4c>
# 1+log lapse
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0

# Gamma-driver shift
shift_eta       = 2.0
shift_advect    = 1.0

# Kreiss-Oliger dissipation
diss            = 0.5
chi_div_floor   = 1e-05

# Constraint damping (Z4c)
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
rhoc        = 1.28e-3 # Central density
kappa       = 100.0    # P = kappa*rho^gamma
npoints     = 10000.0  # buffer points for TOV calculation
dr          = 1e-3     # radial step for TOV calculation
b_norm      = 0.0
pcut        = 1e-6
magindex    = 1
user_hist   = true
v_pert      = -0.024

<output1>
file_type   = rst
dt          = 3.0

<output2>
file_type   = hst      # History data dump
dt          = 0.5
data_format = %20.15e
