<comment>
problem   = Axisymmetric gauge pulse leaving through the Cartoon Sommerfeld boundary (M2b)
# Flat space, alpha = 1 + A exp(-(R^2 + (z - z0)^2)/w^2), puncture gauge. Under 2D Cartoon
# the outer x1 face and both x2 faces are outflow, so Z4c applies its Sommerfeld RHS there;
# the inner x1 face is the axis. History columns from problem/user_hist (z4c_gauge_pulse).

<job>
basename  = cpulse

<mesh>
nghost    = 2
coord     = cylindrical_axisym   # 2D Cartoon (D-014)
nx1       = 64         # R in [0, 8]
x1min     = 0.0
x1max     = 8.0
ix1_bc    = reflect    # the axis
ox1_bc    = outflow    # Sommerfeld
nx2       = 128        # z in [-8, 8]
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 1

<mesh_refinement>
refinement = none

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 24.0

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.02
chi_div_floor   = 1e-05
damp_kappa1     = 0.02
damp_kappa2     = 0.0
constraints_on_output_only = false   # D-025 (the gate test turns it on)

<problem>
pgen_name   = z4c_gauge_pulse
pulse_amp   = 1.0e-3
pulse_width = 1.0
pulse_r0    = 0.0
pulse_z0    = 1.0
user_hist   = true

<output1>
file_type  = hst
dt         = 0.25
data_format = %.17e   # full precision (the D-024 volume check is exact)

<output2>
file_type  = bin      # M2d T1: orders in the causal window (vis/python/cartoon_m2d.py)
single_precision = false
variable   = z4c
dt         = 2.0

<output3>
file_type  = bin
single_precision = false   # doubles: orders below the float floor
variable   = con
dt         = 2.0
