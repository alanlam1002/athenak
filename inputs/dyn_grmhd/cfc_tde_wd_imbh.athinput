# Athena++ (Kokkos version) input file: tidal disruption of a WD-like TOV star by a
# 1e4 Msun IMBH (CFC_PUNCTURE_TDE_PLAN.md Phase B item 10). Star starts at rest at
# x = 30 r_g and falls radially onto the puncture, disrupting near r_t ~ 16 r_g.
#
# WHY 1e4 Msun (not the 1e5 Msun first attempted, see
# cfc_tde_wd_20rg.athinput): with the same 0.7 Msun/~1e4 km star, a 1e5 Msun BH gives
# a tidal radius r_t = R_*(M_BH/M_*)^(1/3) = 3.5 r_g, which is INSIDE the ISCO (6 r_g)
# -- essentially the Hills mass for a white dwarf. That star is swallowed nearly whole
# (a plunge with only a narrow 3.5->2 r_g window of tidal action), not tidally
# disrupted, so it produces no debris streams or fallback curve. At 1e4 Msun,
# r_t = 16.1 r_g sits well outside the ISCO and the disruption is genuine. The 1e5
# case was also ~61,500 cycles (its own star is 10x smaller in r_g, forcing 8 AMR
# levels and hence a 8x smaller CFL dt); this one needs ~11,600.
#
# UNIT CONVERSION: this project's established convention is puncture_mass=1.0, i.e.
# 1 code unit = M_BH, so r_g = GM_BH/c^2 = 1 code unit exactly and star_center_x1=30
# needs no conversion. The star's EOS parameters were specified in standard
# G=c=Msun=1 units (K=2.66e3, Gamma=5/3, rhoc=3.24e-12, verified via a Newtonian
# n=1.5 Lane-Emden check to give M=0.747 Msun, R=1.02e4 km). Rescaling by
# lambda = M_BH/Msun = 1e4 using rho_unit ~ M^-2 and K_unit ~ M^(2*(Gamma-1)):
#   rhoc  = 3.24e-12 * lambda^2      = 3.24e-4
#   kappa = 2.66e3   * lambda^(-4/3) = 1.2346626297e-2
# This makes the star's own radius R_* = 0.6771 r_g (diameter 1.3542).
#
# REFINEMENT -- A TUBE, NOT A BOX AROUND THE STAR. A first attempt (the 1e5 fixture)
# used a small static box centered on the star's INITIAL position. That is a
# correctness bug for an infall problem: the star free-falls out of its own refined
# region almost immediately (there, at t~8 M out of the ~96 M needed to reach r_t),
# after which it lands on root-level cells far larger than the entire star and is
# silently erased. The fix here is a static tube spanning the whole trajectory, from
# past the star's start (x=32) down through the puncture (x=-2), so the star is
# resolved for the entire infall. This deliberately avoids refinement=adaptive, whose
# regridding would trip DEVELOPMENT.md item 38/39's SetNeighbors registration bug --
# still open and unfixed per item 42.
#
# A tube is only affordable because a finest-level MeshBlock spans 16*dx_fine, which
# GROWS as levels are removed: at level 5 that is 0.5 code units, so the 34-unit tube
# costs ~68x8x8 ~ 4100 finest MeshBlocks. The same tube at the 1e5 case's level 8
# would have cost ~8800 finest blocks for a much worse physical setup.
#
# LEVEL 5 (not 4) is chosen for the 16-node/640-rank allocation: level 4 would leave
# only ~3 MeshBlocks per rank (badly under-decomposed, extra ranks wasted on
# communication), whereas level 5 gives ~22 MB/rank and doubles the stellar
# resolution to ~43 cells across the diameter.
#
# dfloor=1e-24 per request. Note this is a HIGHER physical density than the same
# number meant in the 1e5 fixture (rho_unit ~ M^-2), which is numerically safer, and
# is still ~20 orders of magnitude below rhoc.
#
# tlim=200 covers t(30 -> r_t) = 145 M plus disruption aftermath. Restart dumps are
# enabled (dcycle=1000) since ~11,600 cycles will not finish in one SLURM allocation.

<comment>
problem  = Tidal disruption of a 0.7 Msun WD-like TOV star by a 1e4 Msun IMBH (Phase B item 10)

<job>
basename = cfc_tde_wd_imbh

<mesh>
# CUBIC POWER-OF-2 ROOT GRID. 128/16 = 8 root MeshBlocks per axis, so the
# multigrid root hierarchy halves 8x8x8 -> 4x4x4 -> 2x2x2 -> 1x1x1: four root
# levels and a genuine single-cell coarsest grid. The previous 96x64x64 domain
# gave 6x4x4, which halves once to 3x2x2 and stops, so every run printed "The
# root grid can not be reduced to a single cell" and the coarsest grid was
# smoothed iteratively instead of solved. Measured on 2 Aurora nodes / 24 ranks:
# 9.172 -> 7.793 s/cycle (-15%), total V-cycles 760 -> 599 (-21%), with the psi^6
# identity unchanged at 1.104297 (analytic 1.104260) and zero convergence
# failures. dx stays 1.0 at root and 0.03125 at the star, so dt and the star's
# resolution are untouched; only the outer boundary moves 32 -> 64 r_g, which
# also improves the Robin falloff BC.
nghost = 4        # Number of ghost cells
nx1    = 128      # 8 MeshBlocks in x1-direction (root level), dx=1.0
x1min  = -64.0    # minimum x1
x1max  = 64.0     # maximum x1 -- star starts at x=30, ample buffer beyond
ix1_bc = diode    # inner boundary -- full domain, no reflection symmetry
ox1_bc = diode    # outer boundary

nx2    = 128      # 8 MeshBlocks in x2-direction (root level), dx=1.0
x2min  = -64.0    # minimum x2
x2max  = 64.0     # maximum x2
ix2_bc = diode    # inner boundary
ox2_bc = diode    # outer boundary

nx3    = 128      # 8 MeshBlocks in x3-direction (root level), dx=1.0
x3min  = -64.0    # minimum x3
x3max  = 64.0     # maximum x3
ix3_bc = diode    # inner boundary
ox3_bc = diode    # outer boundary

<meshblock>
nx1  = 16        # must be a power of 2 (multigrid requirement)
nx2  = 16
nx3  = 16

<mesh_refinement>
refinement          = static
max_nmb_per_rank    = 400
num_levels          = 6
refinement_interval = 1

<refined_region1>
level = 5        # finest level; dx = 1.0/2^5 = 0.03125 -> ~43 cells across the star
x1min = -2.0     # TUBE spanning the whole infall path: past the star's start at
x1max = 32.0     # x=30, down through the puncture at x=0, so the star never leaves
x2min = -2.0     # the fine grid as it falls (see header note on why a box centered
x2max = 2.0      # on the star's initial position is a correctness bug here).
x3min = -2.0     # Transverse +/-2 is ~3x the stellar diameter (1.354), leaving room
x3max = 2.0      # for tidal spread during disruption.

<time>
evolution  = dynamic    # dynamic/kinematic/static
gr_dt      = true
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = -1
tlim       = 200        # t(30 -> r_t=16.1) = 145 M, plus disruption aftermath
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false     # matches every off-center TOV fixture to date (item 46/48)

<mhd>
eos         = ideal      # EOS type
dyn_eos     = ideal      # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx       # spatial reconstruction method
rsolver     = hlle       # Riemann solver to be used
dfloor      = 1.0e-24    # atmosphere floor (as requested)
tfloor      = 1.0e-22    # matches the established 100x-above-dfloor ratio
dthreshold  = 1.02       # Threshold for flooring
gamma       = 1.6666666666666667  # 5/3, per the WD-like polytrope
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose = true
init_omega   = 1.0
# Measured on 2 Aurora nodes / 24 ranks, 20 cycles, against the 1e-9 settings
# this replaces: 7.80 -> 5.09 s/cycle (-35%), V-cycles 599 -> 292, zero
# convergence failures. Accuracy verified rather than assumed:
#   psi^6 identity unchanged at 1.104297 (analytic 1.104260, 0.0033%)
#   rho-max worst deviation vs the 1e-9 run over 40 cycles: 4.0e-7 relative
#   mass conservation: 1.7e-12 relative
# The defect norm is absolute and unnormalised (multigrid.cpp:697-771 computes
# dV and never applies it; the driver divides only by the constant box volume),
# so mg_threshold is not "digits of accuracy" -- it tightens automatically as
# the mesh refines. 1e-9 was therefore stricter than intended on this 6-level
# mesh. 1e-7 was also measured (-50%) but is NOT used: psi then runs only 2
# V-cycles across 60 solves, i.e. nearly every solve exits immediately, which
# is a qualitative change in solver behaviour that 40 cycles cannot qualify.
mg_threshold   = 1.0e-8
mg_poisson_threshold = 1.0e-8
# mporder 4 -> 2 is 5.4% for free: V-cycle counts are bit-for-bit unchanged
# (599 both ways), so this is pure multipole-evaluation cost, no convergence
# change; the psi^6 identity moves by 2e-12.
mg_poisson_mporder = 2
# 3 was wasted: SetMGTaskListToFiner/ToCoarser (multigrid_tasks.cpp:558,707)
# build at most TWO red-black smoothing iterations per MeshBlock level, so any
# value above 2 is honoured only on the octet and root levels. This is also
# the explanation for DEVELOPMENT.md:2335-2344's open puzzle ("partial
# improvement 1->3, none 3->6").
mg_npresmooth  = 2
mg_npostsmooth = 2
puncture_enabled = true
puncture_mass    = 1.0            # M_BH = 1e4 Msun, fixed at the coordinate origin
<problem>
isotropic   = true      # required: CFC solves for the isotropic-gauge metric
rhoc        = 3.24e-4   # converted from 3.24e-12 (Msun=1 units) via lambda^2
kappa       = 1.2346626297e-2  # converted from 2.66e3 (Msun=1 units) via lambda^(-4/3)
npoints     = 10000.0   # buffer points for TOV calculation
dr          = 2e-4      # npoints*dr = 2.0, ~3x the star's own R_*=0.677
b_norm      = 0.0       # unmagnetized
pcut        = 1e-6
magindex    = 1
star_center_x1 = 30.0    # ~1.9x the tidal radius (16.1) -- starts outside it, at rest
star_center_x2 = 0.0     # puncture always fixed at the origin
star_center_x3 = 0.0
user_hist   = true       # enrolls TOVHistory (rho-max, alpha-min)

<output1>
file_type   = hst      # History data dump -- mass/momentum/energy conservation check
dt          = 0.1
data_format = %20.15e

<output2>
file_type   = bin      # Binary output -- psi/alpha near the puncture and star
variable    = adm
dt          = 1.0      # ~200 dumps over tlim=200 (NOT dcycle=1: that would be ~11,600)
slice_x3    = 0.0
id = adm_xy

<output3>
file_type   = bin      # Binary output -- density, to follow the star and its debris
variable    = mhd_w_bcc
dt          = 1.0
slice_x3    = 0.0
id = prim_xy

<output4>
file_type   = rst      # Restart dumps -- ~11,600 cycles will not fit one allocation
dcycle      = 1000
