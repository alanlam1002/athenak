# AthenaK input file: curvilinear SMR/AMR Phase 2 acceptance gate (cylindrical).
#
# (R,phi): Area1 ~ R varies across every level boundary
#
# The refinement pattern OSCILLATES between the inner and outer half of x1, so blocks are
# repeatedly refined AND derefined. Derefinement is the only path through which RestrictFC
# can act, and a criterion that only ever adds blocks cannot test it -- see
# src/pgen/unit_tests/amr_divb_test.cpp for why this pgen exists instead of an .hst check.

<comment>
problem   = AMR div(B) + mass gate (cylindrical)

<job>
basename  = ut_amr_divb_cylindrical

<mesh>
nghost    = 2
coord     = cylindrical
nx1       = 32
x1min     = 0.5
x1max     = 2.5
ix1_bc    = reflect
ox1_bc    = reflect

nx2       = 32
x2min     = 0.0
x2max     = 6.283185307179586
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement          = adaptive
num_levels          = 2
ncycle_check        = 1
refinement_interval = 1
max_nmb_per_rank    = 2048

<amr_criterion0>
method = user

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 160
tlim       = 1.0e6

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.6666666666666667

<problem>
pgen_name    = amr_divb_test
divb_tol     = 1.0e-10
# Mass tolerance is set by a PRE-EXISTING floor, not by the AMR machinery. Running this
# same problem with refinement disabled drifts by up to 9.4e-11 (cylindrical, 160
# cycles), and the drift grows super-linearly with cycle count -- it tracks the growing
# flow amplitude at the reflecting radial wall, the known non-origin reflecting-wall
# effect from Task B6, not a level-boundary error. AMR consistently does BETTER than
# single level here (1.9e-11 vs 9.4e-11). div(B) above is the primary Phase 2 invariant
# and carries six orders of margin; this is a secondary sanity check.
mass_tol     = 1.0e-9
ref_ncycle   = 20
target_level = 1
d0           = 1.0
amp          = 0.3
p0           = 1.0
bz0          = 0.2
