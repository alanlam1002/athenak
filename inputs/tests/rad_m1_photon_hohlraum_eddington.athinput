<comment>
problem = grey photon M1 1D plane-parallel hohlraum test (arXiv:2302.04283
  Section 3.4, closure_fun=eddington). Identical setup to the companion
  rad_m1_photon_hohlraum_minerbo.athinput (see that file's header for the
  full physics writeup and the DO-side companion test) -- only
  closure_fun differs. Run alongside the minerbo variant specifically to
  show the deviation between the two: the exact solution's Eddington
  factor R^xx/R^tt is exactly 1/3 at x=0 (matches eddington exactly by
  construction) but rises to 1 (fully beamed) at the causal front x=t
  (eddington is fixed at 1/3 everywhere, so it cannot follow this).

<job>
basename = photon_hohlraum_eddington  # name of run

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integration algorithm
cfl_number = 0.4      # ordinary CFL -- a real transport test
nlim       = -1       # cycle limit (safety margin; tlim below is the real limit)
tlim       = 0.75     # matches the paper's Figure 11 comparison time

<mesh>
nghost = 2         # Number of ghost cells
nx1    = 128       # matches the paper ("we use 128 cells in x")
x1min  = 0.0       # minimum value of X1
x1max  = 1.0       # maximum value of X1 -- front at x=c*t=0.75 stays
                   # inside the domain
ix1_bc = outflow   # inner-X1 boundary flag -- required for the wall-value
                   # injection mechanism (see minerbo variant's comment)
ox1_bc = outflow   # outer-X1 boundary flag -- lets radiation exit cleanly

nx2    = 1         # Number of zones in X2-direction (1D test)
x2min  = -0.5      # minimum value of X2
x2max  = 0.5       # maximum value of X2
ix2_bc = periodic  # inner-X2 boundary flag
ox2_bc = periodic  # outer-X2 boundary flag

nx3    = 1         # Number of zones in X3-direction (1D test)
x3min  = -0.5      # minimum value of X3
x3max  = 0.5       # maximum value of X3
ix3_bc = periodic  # inner-X3 boundary flag
ox3_bc = periodic  # outer-X3 boundary flag

<meshblock>
nx1       = 128        # Number of cells in each MeshBlock, X1-dir
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<adm>
# metric defaults to minkowski -- this needs to be here

<coord>
general_rel = true      # general relativity
m           = 0.0
a           = 0.0
excise      = false

<radiation_m1>
closure_fun = eddington  # fixed chi=1/3 closure -- see header comment
src_update = implicit
opacity_type = none    # pure vacuum free-streaming test -- no fluid, no
                      # opacities at all (matches the DO-side hohlraum
                      # pgen and the minerbo variant of this test)

gr_sources = false     # flat spacetime, no need for GR source terms
matter_sources = false # no opacities (opacity_type=none) -- nothing to
                      # couple to
backreact = false      # no fluid present to backreact onto

rad_E_floor = 0.0      # keep the pre-front vacuum region at exactly zero
rad_eps = 0.01         # loosen the causality-bound margin from the default
                      # 1e-14 -- matches the minerbo variant

theta_limiter = false  # default: false

<problem>
pgen_name = rad_m1_beamtest
wall_E = 0.5            # E just outside the wall (x=0+, vacuum side) --
                        # matches the minerbo variant exactly
wall_flux_factor = 0.5  # F_x/E just outside the wall -- matches the
                        # minerbo variant exactly

<output1>
file_type   = tab      # 1D tab output
variable    = rad_m1_E # choice of variables to output
dt          = 0.05     # output increment
data_format = %24.16e  # output precision

<output2>
file_type   = tab       # 1D tab output
variable    = rad_m1_F  # choice of variables to output (Fx, Fy, Fz)
dt          = 0.05      # output increment
data_format = %24.16e   # output precision
