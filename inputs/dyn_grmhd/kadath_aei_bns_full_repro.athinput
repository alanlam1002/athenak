# AthenaK input file for Kadath_AEI (FUKa) BNS initial data.
#
# Full-domain control for kadath_aei_bns_bitant_repro.athinput: identical
# setup (same Kadath initial-data file, same tabulated hybrid EOS, same
# nco=2 tracker refinement, same restart cadence) but a full z-domain (no
# reflect boundary), mirroring the production mr_id_itr2 vs mr_id_itr2_bitant
# comparison.
#
# All coordinates and times are in geometric units (G = c = 1, M_sun = 1)

<comment>
problem   = Kadath_AEI BNS initial data (scaled-down full-domain control)

<job>
basename  = bns_repro_full

<mesh>
nghost     = 4
nx1        = 384      # matches production (mr_id_itr2) exactly
x1min      = -4608
x1max      =  4608
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 384
x2min      = -4608
x2max      =  4608
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 384      # full domain -- matches production's mr_id_itr2 exactly
x3min      = -4608
x3max      =  4608
ix3_bc     = outflow
ox3_bc     = outflow

<meshblock>
nx1        = 64
nx2        = 64
nx3        = 64

<mesh_refinement>
refinement          = adaptive
max_nmb_per_rank    = 100
num_levels          = 9
refinement_interval = 1

<amr_criterion0>
method = user

<z4c_amr>
method = tracker
radius_0_rad = 500
radius_0_reflevel = 3

<refined_region1>
level = 8
x1min =  10.0
x1max =  30.0
x2min = -10.0
x2max =  10.0
x3min = -10.0
x3max =  10.0

<refined_region2>
level = 8
x1min = -30.0
x1max = -10.0
x2min = -10.0
x2max =  10.0
x3min = -10.0
x3max =  10.0

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.25
nlim       = 2
tlim       = 1500
ndiag      = 1

<coord>
general_rel = true
excise      = false
m           = 0.0
a           = 0.0

<mhd>
eos         = ideal
gamma       = 2.0

dyn_eos     = hybrid
dyn_error   = reset_floor
reconstruct = wenoz
rsolver     = hlle
enforce_maximum = true
dmp_M       = 1.2
nscalars    = 0
dfloor      = 5.e-21
fofc        = true
c2p_tol     = 2.49e-13
gamma_max   = 20.025
use_NQT     = false

table = /sakura/ptmp/tlam/PyCompOSE/data/ZLA_a20_B160_g0/ZLA_a20_B160_g0.athtab

<adm>

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0

shift_eta       = 0.3
shift_advect    = 1.0

diss            = 0.5
chi_div_floor   = 1e-05

damp_kappa1     = 0.02
damp_kappa2     = 0.0

nrad_wave_extraction = 1
extraction_radius_0 = 50
waveform_dt = 2.5

nco         = 2
co_0_type   = NS
co_0_x      = 20.0
co_0_radius = 8.0
co_1_type   = NS
co_1_x      = -20.0
co_1_radius = 8.0
tracker_mode = walk

<problem>
initial_data_file = /sakura/ptmp/tlam/Kadath_release/apps/BNS/sbatch_outputs/converged_BNS_ECC_RED.ZLA_a20_B160_g0.40.0.z0.0.z0.2.7.q1.0.0.0.17.toml
user_hist         = true
table = /sakura/ptmp/tlam/PyCompOSE/data/ZLA_a20_B160_g0/ZLA_a20_B160_g0.athtab

<output1>
file_type = hst
dt        = 0.375
data_format = %24.17e

<output2>
file_type = rst
dcycle    = 1
