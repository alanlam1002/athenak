<comment>
problem = grey photon M1 free-streaming beam test (1D Minkowski), MPI-decomposed
  (4 meshblocks/4 ranks) variant of rad_m1_photon_beam_1d.athinput used by
  test_rad_m1_photon_beam_1d_mpicpu.py -- identical physics, only
  meshblock/nx1 differs, to confirm domain decomposition doesn't change the
  result.

<job>
basename = photon_beam_1d  # name of run

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integration algorithm
cfl_number = 0.4      # ordinary CFL -- a real transport test
nlim       = 4000     # cycle limit (safety margin; tlim below is the real limit)
tlim       = 6.0      # time limit -- beam front reaches x=c*t=6, leaving 2
                      # domain units of margin before the outer boundary

<mesh>
nghost = 2         # Number of ghost cells
nx1    = 400       # Number of zones in X1-direction
x1min  = 0.0       # minimum value of X1
x1max  = 8.0       # maximum value of X1
ix1_bc = outflow   # inner-X1 boundary flag -- required: the beam is
                   # injected into the ghost zones on this face only when
                   # this flag is "outflow" (radiation_m1_beams.cpp)
ox1_bc = outflow   # outer-X1 boundary flag -- lets the beam exit cleanly,
                   # no reflection back into the domain

nx2    = 1         # Number of zones in X2-direction (1D test)
x2min  = -0.5      # minimum value of X2
x2max  = 0.5       # maximum value of X2
ix2_bc = periodic  # inner-X2 boundary flag
ox2_bc = periodic  # outer-X2 boundary flag

nx3    = 1         # Number of zones in X3-direction (1D test)
x3min  = -0.5      # minimum value of X3
x3max  = 0.5       # maximum value of X3
ix3_bc = periodic  # inner-X3 boundary flag
ox3_bc = periodic  # outer-X3 boundary flag

<meshblock>
nx1       = 100        # Number of cells in each MeshBlock, X1-dir (4 blocks/ranks)
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<adm>
# metric defaults to minkowski -- this needs to be here

<mhd>
eos         = ideal     # EOS type
gamma       = 2.0       # ratio of specific heats Gamma

dyn_eos     = ideal      # EOS type
dyn_error   = reset_floor # error policy
reconstruct = dc      # spatial reconstruction method (fluid state is uniform,
                      # so reconstruction order doesn't matter for the gas)
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.0e-16   # floor on density rho
fofc        = false
enforce_maximum = false

<coord>
general_rel = true      # general relativity
m           = 0.0
a           = 0.0
excise      = false

<radiation_m1>
closure_fun = minerbo  # NOT eddington: eddington pins chi=1/3 (isotropic),
                      # which cannot represent a directed beam (chi->1 in
                      # the free-streaming limit) -- minerbo is also the
                      # code default, matching the existing neutrino-path
                      # beam test (radiation_beam_1d.athinput)
src_update = implicit
opacity_type = photons

gr_sources = false     # flat spacetime, no need for GR source terms
matter_sources = true  # default: true -- exercise the real photon-opacity
                      # source term (with tiny kappas, see below)
backreact = false      # keep gas static/uniform for this test (backreaction
                      # is a separate, later test)

rad_E_floor = 0.0      # keep the pre-beam-front region at exactly zero
                      # (clean signal), matching the existing neutrino beam
                      # test's convention
rad_eps = 0.01         # loosen the causality-bound margin from the default
                      # 1e-14 -- also matches the existing neutrino beam
                      # test, avoids numerical fragility exactly at F=E

theta_limiter = false  # default: false

<photons>
kappa_a = 0.0          # zero absorption/emission -- see below
kappa_p = 0.0          # zero: kappa_a=kappa_p=0 avoids a confound found by
                      # hand: with both nonzero, the static T=1 gas emits
                      # locally (LTE) everywhere in the domain from t=0
                      # regardless of the beam (background E ~ kappa_p*t,
                      # confirmed to match this formula to high precision
                      # ahead of the beam front in an initial trial run with
                      # kappa_a=kappa_p=1e-3), which for kappa_a=kappa_p
                      # happens to equal the beam's own equilibrium value
                      # (J_eq=arad*T^4=1=E_beam) and entangles with the beam
                      # signal in the illuminated region. Zeroing both
                      # isolates exactly the physics this test is meant to
                      # check: does weak scattering alone spuriously damp or
                      # spread the beam? (builds on the already-validated
                      # Stage 1 scattering-only single-zone null test, which
                      # confirmed scattering alone conserves E exactly in a
                      # homogeneous setting -- here we check the same holds
                      # in a genuinely transporting, non-homogeneous beam).
kappa_s = 1.0e-3       # small but nonzero scattering opacity [code units] --
                      # exercises the photon-opacity code path (nonzero
                      # scat_1) genuinely, while cdt*kscat over the full
                      # tlim=6 is ~6e-3, tiny, so any beam damage should be
                      # correspondingly tiny if the scheme is correct
power_opacity = false  # constant (non-Kramers) opacities
compton = false        # no <units> block, so Compton is unavailable
arad = 1.0             # radiation constant [code units] -- unused here
                      # since kappa_p=0 means no emission/absorption channel

<problem>
pgen_name = rad_m1_beamtest
rho = 1.0   # initial density [code], uniform in space
temp = 1.0  # initial temperature [code], uniform in space

<output1>
file_type   = tab         # Binary data dump
variable    = rad_m1_E    # choice of variables to output
dt          = 0.5         # time increment between outputs

<output2>
file_type   = tab         # Binary data dump
variable    = rad_m1_F    # choice of variables to output (Fx:0, Fy:0, Fz:0)
dt          = 0.5         # time increment between outputs
