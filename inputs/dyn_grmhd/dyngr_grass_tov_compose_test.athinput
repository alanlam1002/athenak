# AthenaK input file: smoke test for dyngr_grass pgen with the runtime dyn_eos=compose
# EOS (3D trapped-neutrino DD2 table) + 1D DD2_hot_slice Y[e] seeding.
#
# dfloor derivation (see examples/DD2_hot/verify_mn_scalar.py, section 3):
#   nb_min_3D = 1e-12 fm^-3 (examples/DD2's own native floor)
#   GetBaryonMass()-equivalent(mn=MN_GRASS), code units = 0.002711994197437188
#   dfloor_code = nb_min_3D * GetBaryonMass()-equivalent = 2.711994197437188e-15
# Set explicitly at/above this value rather than relying on EOSCompOSE's silent
# clamp to the table's own min_n (eos.hpp:479-481). Only valid for
# <mhd> units=geometric_solar (the default, omitted below).

<comment>
problem   = GRASS-initial-data neutron star (non-rotating smoke test, dyn_eos=compose)

<job>
basename  = grass_tov_compose_smoke

<mesh>
nghost     = 3        # Number of ghost cells
nx1        = 32       # Number of zones in X1-direction
x1min      = -24      # minimum value of X1 (code units, ~ a few stellar radii)
x1max      =  24      # maximum value of X1
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 32
x2min      = -24
x2max      =  24
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 32
x3min      = -24
x3max      =  24
ix3_bc     = outflow
ox3_bc     = outflow

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.25
nlim       = 0        # just build initial data + constraints, no evolution steps
tlim       = 1000
ndiag      = 1

<coord>
general_rel = true
excise      = false
m           = 0.0
a           = 0.0

<mhd>
eos         = ideal
gamma       = 2.0
dyn_eos     = compose
dyn_error   = reset_floor
reconstruct = ppmx
rsolver     = hlle
dfloor      = 2.8e-15   # >= dfloor_code derived above
tfloor      = 1.0e-3
pfloor      = 1.0e-20
dthreshold  = 1.02
dyn_scratch = 1
fofc        = false
enforce_maximum = false
table       = /u/tlam/GRASS/eos/DD2_hot_trapped_3d.athtab
nscalars    = 1

<adm>

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 0.3
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1e-05
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
id_file         = /sakura/ptmp/tlam/athenak_run/pgen_grass_smoke/res_default_TOV.rst
grass_eos_table = /u/tlam/GRASS/eos/DD2_hot_equal_pinned.dat
table           = /u/tlam/GRASS/eos/DD2_hot_slice.athtab
user_hist       = true

<output1>
file_type   = hst
dt          = 1.0

<output2>
file_type   = bin
variable    = mhd_w
dt          = 1000.0
slice_x3    = 0.0

<output3>
file_type   = bin
variable    = adm
dt          = 1000.0
slice_x3    = 0.0
