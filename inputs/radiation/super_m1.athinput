<job>
basename = m1boltzmann_super_m1

<mesh>
nghost = 4

# NOTE: DO side (super.athinput) uses ix*_bc/ox*_bc = user (NoInflowTorus, registered by
# gr_torus.cpp/gr_torus_m1.cpp), which explicitly prevents inflow on top of plain
# outflow. NoInflowTorus's ConsToPrim/PrimToCons ghost-zone round-trip calls
# pmbp->pmhd->peos-> directly with no pdyngr branch -- a pre-existing gap in this
# inherited code (confirmed shared by z4c_circumbinary.cpp's identical copy, not
# introduced by this file), fatal ("NoOp MHD ConsToPrim called") once dyn_grmhd is
# active. Switched to plain outflow here instead of fixing that shared code -- the
# domain (+-1024) is >>17x the torus's r_peak=58, so inflow at the domain edge actually
# mattering during any reasonable run duration is negligible.
nx1    = 128
x1min  = -1024.0
x1max  = 1024.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 128
x2min  = -1024.0
x2max  = 1024.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 128
x3min  = -1024.0
x3max  = 1024.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 32

<mesh_refinement>
refinement = static
prolong_primitives = true

<refinement1>
level = 1
x1min = -1024.0
x1max = 1024.0
x2min = -1024.0
x2max = 1024.0
x3min = -512.0
x3max = 512.0

<refinement2>
level = 2
x1min = -512.0
x1max = 512.0
x2min = -512.0
x2max = 512.0
x3min = -256.0
x3max = 256.0

<refinement3>
level = 3
x1min = -256.0
x1max = 256.0
x2min = -256.0
x2max = 256.0
x3min = -128.0
x3max = 128.0

<refinement4>
level = 4
x1min = -128.0
x1max = 128.0
x2min = -128.0
x2max = 128.0
x3min = -64.0
x3max = 64.0

<refinement5>
level = 5
x1min = -64.0
x1max = 64.0
x2min = -64.0
x2max = 64.0
x3min = -32.0
x3max = 32.0

<refinement6>
level = 6
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -16.0
x3max = 16.0

<refinement7>
level = 7
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -8.0
x3max = 8.0

<refinement8>
level = 8
x1min = -8.0
x1max = 8.0
x2min = -8.0
x2max = 8.0
x3min = -4.0
x3max = 4.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 50000.0
ndiag      = 100

<coord>
general_rel = true
a           = 0.3
excise      = true
dexcise     = 1.0e-7
pexcise     = 3.3333333333333335e-13

<adm>
# radiation_m1 hard-requires this block to exist ("radiation_m1 is only supported with
# dynamical spacetimes", radiation_m1.cpp) -- deliberately left otherwise empty: omitting
# "dynamic" defaults to false (adm.cpp), and with no <z4c> block present nothing ever
# evolves these fields after the initial fill, so the BH background stays exactly the
# same fixed Kerr-Schild metric (same <coord>/a=0.3) that the DO run's <coord>-only path
# uses directly -- just reached through the ADM 3+1 fields instead of the direct
# coordinate formulas, since radiation_m1's own solver reads the metric that way.
# This also means MHD now evolves through the dyn_grmhd solver (pmbp->pdyngr) rather
# than the plain fixed-background solver the DO run uses -- gr_torus.cpp/gr_torus_m1.cpp
# already branch on pmbp->padm==nullptr for this at the PrimToCons call, so it's a
# pre-existing, already-exercised code path, not new machinery.

<mhd>
eos         = ideal
dyn_eos     = ideal            # dyn_grmhd requires this explicitly (dyn_grmhd.cpp);
dyn_error   = reset_floor      # matches dyngr_bhstar_radiation.athinput's precedent
reconstruct = ppm4
rsolver     = hlle
dfloor      = 1.0e-7
pfloor      = 3.3333333333333335e-13
sfloor      = 5.e-7
sfloor1     = 1.e-5
sfloor2     = 3.e-7
rho1        = 1.e-6
rho2        = 1.e0
gamma       = 1.6666666666666667
fofc        = true
gamma_max   = 20.0

<radiation_m1>
opacity_type    = photons        # required -- gr_torus_m1.cpp reads photon_op_params
closure_fun     = minerbo        # default; genuine rotational anisotropy here (matches
                                  # dyngr_bhstar_radiation.athinput's own reasoning),
                                  # unlike the flat LTE single-zone tests
src_update      = implicit       # default
gr_sources      = true           # default -- genuinely curved spacetime here
matter_sources  = true           # default
backreact       = true           # default -- let gas and radiation exchange energy,
                                  # matching the DO run's own backreacting setup
backreact_tmunu = true           # default
theta_limiter   = true           # NOT the default (false) -- required here. Without it,
                                  # the backreaction injection into umhd0_ is completely
                                  # unclamped (theta=1.0 always), and a single converged
                                  # Newton solve for the radiation subsystem can imply an
                                  # energy/momentum transfer far larger than the gas's own
                                  # tiny reservoir (urad/pgas~130 in this test) -- confirmed
                                  # via a DEBUG_BUILD SrcSignal diagnostic to be the actual
                                  # mechanism here (dominated by converged single-step
                                  # Hybridsj solves, NOT the SrcThin-drift mechanism
                                  # DEVELOPMENT.md's Stage 8 found for its own, simpler
                                  # single-zone reproducer of a superficially similar
                                  # blow-up -- see Stage 14). With theta_limiter=true, the
                                  # existing (energy/tau-reservoir-only, no momentum bound)
                                  # clamp is sufficient to keep this test stable through
                                  # tlim=500 with zero disk-material C2P failures.
source_limiter  = 0.5            # default; the theta_limiter clamp above needs this set

<photons>
kappa_s       = 0.40   # matches <radiation>/kappa_s on the DO side exactly
power_opacity = true   # matches <radiation>/power_opacity=true -- kappa_a/kappa_p are
                        # computed from a power-law (Kramers-type) formula instead of
                        # fixed constants, so (like the DO side) neither is set here
compton       = true   # matches <radiation>/compton=true; requires <units> below
matter_implicit = true # NOT a DO-side parameter, and NOT radiation_m1's own default
                        # (false) -- required for Compton to actually do anything: the
                        # frozen-opacity path (matter_implicit=false) has zero Compton
                        # contribution at all (radiation_m1_calc_opacities_photons.cpp),
                        # confirmed the hard way earlier in this same project (see
                        # src/radiation_m1/DEVELOPMENT.md's Stage 5/6 notes and the
                        # compton_singlezone regression gap) -- setting this explicitly
                        # is deliberate, not a default carried over by accident.
# arad: not set here, exactly like the DO side -- both derive it from the <units> block
# below instead (pmbp->pradm1->photon_op_params.arad), so there is only one arad, read
# consistently by both the IC (gr_torus_m1.cpp) and the evolved opacities.

<units>
bhmass_msun = 10.0
density_cgs = 3.0e-3
mu          = 0.5

<problem>
chakrabarti_torus  = true
sane               = true
r_edge             = 15.0
r_peak             = 58.0
tilt_angle         = 0.0
rho_max            = 1.0
potential_beta_min = 80.56701840737531
potential_cutoff   = 0.2
rho_min            = 1.0e-5
rho_pow            = -1.5
pgas_min           = 3.333333333333333e-8
pgas_pow           = -2.5
pert_amp           = 0.0
user_hist          = true

<output1>
file_type      = hst
dt             = 10.0
user_hist_only = true

# NOTE: unlike the DO side's single "rad_mhd_w_bcc" (one bundled hydro+radiation
# variable), radiation_m1 has no combined MHD+M1 output variable -- basetype_output.cpp
# only offers "mhd_w_bcc" (hydro/MHD primitives) and separately "rad_m1_E"/"rad_m1_F"
# (M1's own lab-frame energy density / flux moments) as distinct variable strings, each
# needing its own <output> block. Split into 3 blocks per cadence/slice below so the
# comparable physical content (density/velocity/B-field, plus E and F^i in place of the
# DO run's full angle-resolved intensity) is still all present, just as separate files.

<output2>
file_type = bin
id        = full
variable  = mhd_w_bcc
dt        = 100.0

<output3>
file_type = bin
id        = full_E
variable  = rad_m1_E
dt        = 100.0

<output4>
file_type = bin
id        = full_F
variable  = rad_m1_F
dt        = 100.0

<output5>
file_type = bin
slice_x1  = 0.0
id        = slice_x
variable  = mhd_w_bcc
dt        = 10.0

<output6>
file_type = bin
slice_x1  = 0.0
id        = slice_x_E
variable  = rad_m1_E
dt        = 10.0

<output7>
file_type = bin
slice_x1  = 0.0
id        = slice_x_F
variable  = rad_m1_F
dt        = 10.0

<output8>
file_type = bin
slice_x2  = 0.0
id        = slice_y
variable  = mhd_w_bcc
dt        = 10.0

<output9>
file_type = bin
slice_x2  = 0.0
id        = slice_y_E
variable  = rad_m1_E
dt        = 10.0

<output10>
file_type = bin
slice_x2  = 0.0
id        = slice_y_F
variable  = rad_m1_F
dt        = 10.0

<output11>
file_type = bin
slice_x3  = 0.0
id        = slice_z
variable  = mhd_w_bcc
dt        = 10.0

<output12>
file_type = bin
slice_x3  = 0.0
id        = slice_z_E
variable  = rad_m1_E
dt        = 10.0

<output13>
file_type = bin
slice_x3  = 0.0
id        = slice_z_F
variable  = rad_m1_F
dt        = 10.0

<output14>
file_type = rst
dt        = 250.0
