# AthenaK input file for Task F1 unit test: spherical radial Sod shock tube, on a
# CLOSED domain (reflect at both r=0 and the outer boundary) so total mass/energy must
# be conserved exactly (to roundoff), using the existing (coordinate-generic, unmodified)
# shock_tube pgen -- it only needs to classify cells as left/right of xshock, which the
# arithmetic-midpoint position it already uses is exactly as valid for as the volumetric
# centroid would be (both sides of the shock are locally uniform states, so this is a
# pure step function, not a smooth profile -- see DEVELOPMENT.md Task F1 log for why no
# new pgen was needed). tlim is chosen so neither the shock nor the rarefaction reaches
# either wall (starting 0.5 from each, sound speed ~1.2 in the left state).

<comment>
problem   = spherical radial Sod shock tube (Task F1)
reference = Sod, G.A., JCP 27, pp. 1-31 (1978)

<job>
basename  = ut_f1_spherical_sod

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = reflect
ox1_bc    = reflect

nx2       = 1
x2min     = 0.0
x2max     = 3.14159265358979324
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 128
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = -1
tlim       = 0.3
ndiag      = 10

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
gamma       = 1.4

<problem>
pgen_name = shock_tube
shock_dir  = 1
xshock     = 0.5

dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0

dr = 0.125
pr = 0.1
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = hst
dt        = 0.01
