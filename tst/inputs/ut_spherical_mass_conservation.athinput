# AthenaK input file for Task B4 (conservation half) unit test: mass conservation for
# the spherical (r,theta,phi) area/volume-weighted flux divergence (Tasks A3/B3) on the
# REQUIRED 1D-radial layout, including the true r=0 origin (reflecting boundary there).
# Closed domain: reflecting at r=0 and at the outer r boundary. Since nx2=nx3=1
# (multi_d=three_d=false), only the radial flux-divergence term is ever evaluated
# (hydro_update.cpp's multi_d/three_d branches don't fire), so this isolates exactly the
# radial telescoping property -- the most direct test of Area1(is)=r_f(is)^2=0 exactly
# at r=0 (verified in the B3 geometry factory) actually preventing any mass flux there.

<comment>
problem   = shock tube in a spherical shell (mass-conservation unit test)

<job>
basename  = ut_spherical_mass_conservation

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 32
x1min     = 0.0
x1max     = 2.0
ix1_bc    = reflect
ox1_bc    = reflect

nx2       = 1
x2min     = 0.0
x2max     = 3.14159265358979324
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 32
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 0.05
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = shock_tube
shock_dir  = 1
xshock     = 1.0

dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0

dr = 0.6
pr = 0.5
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = hst
dt        = 0.005
