# AthenaK input file for resistive GRMHD unit tests (K1, K6, diagnostics)

<comment>
problem   = resistive GRMHD unit tests

<job>
basename  = resistive_unit_tests

<mesh>
nghost    = 2
nx1       = 16
x1min     = -1.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 16
x2min     = -0.5
x2max     = 1.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 16
x3min     = -2.0
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = static
cfl_number = 0.3
integrator = rk2
nlim       = 0
tlim       = 0
ndiag      = 1

<hydro>                 # a physics module is required by MeshBlockPack; unused
eos   = ideal
gamma = 1.6666666667
reconstruct = plm
rsolver = advect

<problem>
pgen_name = resistive_unit_tests
ntrial    = 4096
