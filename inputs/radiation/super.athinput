<job>
basename = m1boltzmann_super

<mesh>
nghost = 4

nx1    = 128
x1min  = -1024.0
x1max  = 1024.0
ix1_bc = user
ox1_bc = user

nx2    = 128
x2min  = -1024.0
x2max  = 1024.0
ix2_bc = user
ox2_bc = user

nx3    = 128
x3min  = -1024.0
x3max  = 1024.0
ix3_bc = user
ox3_bc = user

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 32

<mesh_refinement>
refinement = static
prolong_primitives = true

<refinement1>
level = 1
x1min = -1024.0
x1max = 1024.0
x2min = -1024.0
x2max = 1024.0
x3min = -512.0
x3max = 512.0

<refinement2>
level = 2
x1min = -512.0
x1max = 512.0
x2min = -512.0
x2max = 512.0
x3min = -256.0
x3max = 256.0

<refinement3>
level = 3
x1min = -256.0
x1max = 256.0
x2min = -256.0
x2max = 256.0
x3min = -128.0
x3max = 128.0

<refinement4>
level = 4
x1min = -128.0
x1max = 128.0
x2min = -128.0
x2max = 128.0
x3min = -64.0
x3max = 64.0

<refinement5>
level = 5
x1min = -64.0
x1max = 64.0
x2min = -64.0
x2max = 64.0
x3min = -32.0
x3max = 32.0

<refinement6>
level = 6
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -16.0
x3max = 16.0

<refinement7>
level = 7
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -8.0
x3max = 8.0

<refinement8>
level = 8
x1min = -8.0
x1max = 8.0
x2min = -8.0
x2max = 8.0
x3min = -4.0
x3max = 4.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 50000.0
ndiag      = 100

<coord>
general_rel = true
a           = 0.3
excise      = true
dexcise     = 1.0e-7
pexcise     = 3.3333333333333335e-13

<mhd>
eos         = ideal
reconstruct = ppm4
rsolver     = hlle
dfloor      = 1.0e-7
pfloor      = 3.3333333333333335e-13
sfloor      = 5.e-7
sfloor1     = 1.e-5
sfloor2     = 3.e-7
rho1        = 1.e-6
rho2        = 1.e0
gamma       = 1.6666666666666667
fofc        = true
gamma_max   = 20.0

<radiation>
reconstruct   = plm
rotate_geo    = false
nlevel        = 2
power_opacity = true
compton       = true
kappa_s       = 0.40
n_0_floor     = 0.1
correct_radsrc_opacity = true
dfloor_opacity         = 1.e-14
dens_trunc_max         = 1.e-4
tau_truncation         = 1.5e-5
sigmoid_residual       = 1.e-2

<units>
bhmass_msun = 10.0
density_cgs = 3.0e-3
mu          = 0.5

<problem>
chakrabarti_torus  = true
sane               = true
r_edge             = 15.0
r_peak             = 58.0
tilt_angle         = 0.0
rho_max            = 1.0
potential_beta_min = 80.56701840737531
potential_cutoff   = 0.2
rho_min            = 1.0e-5
rho_pow            = -1.5
pgas_min           = 3.333333333333333e-8
pgas_pow           = -2.5
pert_amp           = 0.0
user_hist          = true

<output1>
file_type      = hst
dt             = 10.0
user_hist_only = true

<output2>
file_type = bin
id        = full
variable  = rad_mhd_w_bcc
dt        = 100.0

<output3>
file_type = bin
slice_x1  = 0.0
id        = slice_x
variable  = rad_mhd_w_bcc
dt        = 10.0

<output4>
file_type = bin
slice_x2  = 0.0
id        = slice_y
variable  = rad_mhd_w_bcc
dt        = 10.0

<output5>
file_type = bin
slice_x3  = 0.0
id        = slice_z
variable  = rad_mhd_w_bcc
dt        = 10.0

<output6>
file_type = rst
dt        = 250.0
