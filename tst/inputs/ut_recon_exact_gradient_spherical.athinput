# AthenaK input file for Task B6 unit test: PLM exact-linear-gradient reconstruction,
# spherical (non-uniform volumetric centroid spacing in r, the required 1D-radial
# layout).

<comment>
problem   = PLM exact-linear-gradient reconstruction unit test (spherical)

<job>
basename  = ut_recon_exact_gradient_spherical

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 16
x1min     = 1.0
x1max     = 5.0
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 1
x2min     = 0.0
x2max     = 3.14159265358979324
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 16
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 0
tlim       = 0.0

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = recon_exact_gradient_test
