# AthenaK input file for Task B6 unit test: PLM exact-linear-gradient reconstruction,
# cylindrical (non-uniform volumetric centroid spacing in R).

<comment>
problem   = PLM exact-linear-gradient reconstruction unit test (cylindrical)

<job>
basename  = ut_recon_exact_gradient_cylindrical

<mesh>
nghost    = 2
coord     = cylindrical
nx1       = 16
x1min     = 0.5
x1max     = 2.5
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 16
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 0
tlim       = 0.0

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = recon_exact_gradient_test
