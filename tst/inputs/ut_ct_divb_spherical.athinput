# AthenaK input file for Task D2 unit test: div(B)=0 preservation under the area/edge-
# length-weighted CT curl (Task D1), spherical_polar (r,theta), avoiding the pole.

<comment>
problem   = CT div(B)=0 unit test (spherical, 2D r-theta)

<job>
basename  = ut_ct_divb_spherical

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 16
x1min     = 1.0
x1max     = 2.0
ix1_bc    = reflect
ox1_bc    = reflect

nx2       = 16
x2min     = 0.3
x2max     = 2.8
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 0.3

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlle
gamma       = 1.4

<problem>
pgen_name = ct_divb_test
amp       = 0.3
dens      = 1.0
pgas      = 1.0
v0        = 0.1
