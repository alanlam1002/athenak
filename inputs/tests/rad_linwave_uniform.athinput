<comment>
problem = DO-side radiation-hydrodynamic linear wave test (Stage 13,
  arXiv:2302.04283 Section 3.9), gas-dominated "H1" case (p_rad/p_gas=1/10).
  Uniform-grid variant of the already-existing, already-CI-wired
  tst/inputs/lwave_rad.athinput -- same pgen (rad_linear_wave.cpp,
  ProblemGenerator::RadiationLinearWave, already implements the full
  Eddington-closure eigensystem, nothing new here), same background state
  and eigenvalue/eigenvector (verbatim from the paper's own Appendix A
  Table 1/2 "H1" values), just without adaptive mesh refinement -- this
  file exists purely to get a clean two-resolution (32/64) convergence
  comparison against the new M1-side counterpart
  (rad_m1_photon_linear_wave.athinput), matching the CI test's own
  resolution pair (test_rad_lwave1d_amr_cpu.py) but without AMR
  complicating the M1-side comparison. delta=1.0e-4 matches the paper's
  own perturbation amplitude (not this repo's inputs/tests/
  rad_linwave.athinput's delta=1.0e-6 -- that file predates the AMR CI
  variant and uses a different, smaller amplitude for its own legacy
  regression script).

  NOTE: <time>/tlim below is a MULTIPLIER of the wave's damping time, not
  a literal time -- rad_linear_wave.cpp:181-184 rewrites it via
  tlim_actual = tlim_input * ln(2)/|omega_imag|. tlim=1.0 here means "run
  until the wave has decayed by one full doubling time" (matches the
  paper's own prescription, Eq. 77's surrounding text: "run for a time of
  -log(2)/Im(omega)").

<job>
basename = rad_linwave_uniform

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 1.0

<mesh>
nghost = 4
nx1    = 64        # overridden to 32 for the low-resolution run
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = 0.0
x2max  = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = 0.0
x3max  = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64           # overridden to 32 for the low-resolution run
nx2 = 1
nx3 = 1

<coord>
general_rel = true
minkowski   = true

<hydro>
eos         = ideal
reconstruct = wenoz
rsolver     = hlle
gamma       = 1.6666666666666667  # Gamma_gas = 5/3, matches the paper

<radiation>
nlevel         = 0
rotate_geo     = false
angular_fluxes = false
reconstruct    = plm
kappa_a        = 10.0             # matches the paper's alpha_bar_a = 10
kappa_s        = 10.0             # matches the paper's alpha_bar_s = 10
kappa_p        = 0.0
arad           = 19.253382731290966   # Table 1 "H1" arad value

<problem>
pgen_name   = rad_linear_wave
along_x1    = true
along_x2    = false
along_x3    = false
rho         = 1.0
pgas        = 2.497687326549491e-01     # Table 1 "H1"
erad        = 7.493061979648474e-02     # Table 1 "H1"
delta       = 1.0e-4                    # paper's own perturbation amplitude
omega_real  =  3.1488157526582414e+00   # Table 2 "H1"
omega_imag  = -2.6190006385782953e-02
drho_real   =  8.3877889167048014e-01
drho_imag   =  0.0
dpgas_real  =  3.2084488925731219e-01
dpgas_imag  = -9.9134535607493107e-03
dux_real    =  4.2035369927276667e-01
dux_imag    = -3.4962560317943620e-03
derad_real  =  1.2904189937790903e-01
derad_imag  =  1.5203926879094193e-03
dfxrad_real =  1.3260665610966586e-03
dfxrad_imag = -6.7017329068802516e-03

<output1>
file_type   = tab        # 1D -- tab is fine
variable    = hydro_w
dt          = 100.0      # only need the final snapshot

<output2>
file_type   = tab
variable    = rad_coord
dt          = 100.0
