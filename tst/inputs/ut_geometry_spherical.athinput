# AthenaK input file for Task B4 unit test: spherical (r,theta,phi) geometry
# construction. 1D radial (nx2=nx3=1), full solid angle (x2:[0,pi], x3:[0,2pi]) so the
# pgen's Area1=4*pi*r_f^2 full-sphere sanity check fires -- this is the required layout.

<comment>
problem   = spherical MeshGeometry/GeomData construction unit test

<job>
basename  = ut_geometry_spherical

<mesh>
nghost    = 2
coord     = spherical_polar
nx1       = 16
x1min     = 1.0
x1max     = 5.0
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 1
x2min     = 0.0
x2max     = 3.14159265358979324
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 8
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 0
tlim       = 0.0

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = geometry_curvilinear_test
