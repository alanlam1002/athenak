<comment>
problem = grey photon M1 colliding-beams test (Stage 12, arXiv:2302.04283
  Section 3.1). Companion DO-side test:
  inputs/tests/rad_crossing_beams.athinput -- see that file's header for
  the full physics motivation (this is exactly the test the paper says
  "is failed by M1 and commonly employed closure methods": two beams
  crossing in vacuum "merge into a single beam pointing in the average
  direction... when using M1"). This pgen exists to measure that merging
  directly rather than just cite the paper's claim.

  M1 tracks only a single (E, F_d) pair per cell -- no angular resolution
  at all -- so unlike the DO-side companion, there is no way to represent
  two simultaneous beam directions in the same cell; downstream of the
  crossing point, the solver can only carry their vector-summed flux,
  which looks like one beam in the averaged direction. New pgen:
  RadiationM1CrossingBeams (src/pgen/tests/rad_m1_colliding_beams.cpp),
  reusing the same boundary-ghost-cell injection pattern as the existing
  2D beam test (ApplyBeamSources2D), generalized to two simultaneous
  beams with independent y-bands and directions.

  Simplification vs. the DO-side test (documented, not hidden): the
  paper's sources are circular regions strictly inside the domain (radius
  1/10 at x=2/15); M1 has no existing interior volumetric point-source
  mechanism, so both sources are placed at the domain's left edge
  (x=x1min=0) instead of x=2/15 -- a small shift in the sources' exact
  x-position, not a change to the qualitative physics (whether the two
  beams merge downstream of their sources). Geometry otherwise matches
  the paper/DO-side test exactly: y_lower=2/15, y_upper=13/15
  (=1/2+-11/30), beam_angle=pi/6.

<job>
basename = photon_colliding_beams

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 2.5      # matches the DO-side companion / paper's t=5/2

<mesh>
nghost = 2
nx1    = 96        # matches the DO-side companion test exactly (and the
                   # paper's own 96x60 grid), for an apples-to-apples
                   # spatial comparison
x1min  = 0.0
x1max  = 1.6
ix1_bc = outflow   # required: the colliding-beam values are injected into
                   # the ghost zones on this face only when this flag is
                   # "outflow" (ApplyM1CollidingBeamSources2D, same
                   # convention as the existing 2D beam test)
ox1_bc = outflow   # lets both beams exit the domain cleanly

nx2    = 60
x2min  = 0.0
x2max  = 1.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 96
nx2 = 60
nx3 = 1

<adm>
# metric defaults to minkowski -- this needs to be here

<coord>
general_rel = true
m           = 0.0
a           = 0.0
excise      = false

<radiation_m1>
closure_fun = minerbo  # NOT eddington: eddington pins chi=1/3, which
                      # cannot represent a directed beam at all (matches
                      # the existing 1D beam test's established
                      # convention) -- irrelevant to the specific failure
                      # this test targets (that's a single-direction-per-
                      # cell limitation, not a closure-shape issue), but
                      # keeping eddington would confound the comparison
                      # with a second, unrelated closure artifact
src_update = implicit
opacity_type = none    # pure vacuum free-streaming test -- no fluid, no
                      # opacities at all, matching the DO-side companion
                      # (no <hydro>/<mhd> block either)

gr_sources = false     # flat spacetime, matching the DO-side companion
matter_sources = false # no opacities -- nothing to couple to
backreact = false      # no fluid present to backreact onto

rad_E_floor = 0.0      # keep the unilluminated region at exactly zero
rad_eps = 0.01         # loosen the causality-bound margin from the
                      # default 1e-14 -- matches the existing beam test
                      # (both injected beams are causality-saturated,
                      # flux factor 1)

theta_limiter = false  # default: false

<problem>
pgen_name          = rad_m1_crossing_beams
beam_E             = 1.0
beam_angle         = 0.5235987755982988   # = pi/6, matches the DO-side
                                          # companion's beam direction
                                          # exactly
beam_y_lower       = 0.13333333333333333  # = 2/15 = 1/2 - 11/30, matches
                                          # the DO-side companion exactly
beam_y_upper       = 0.8666666666666667   # = 13/15 = 1/2 + 11/30
beam_band_halfwidth = 0.1                 # ~ the paper's source radius
                                          # 1/10 (full band width 0.2)

<output1>
file_type = bin       # genuinely 2D field -- tab only supports 1D slices
variable  = rad_m1_E
dt        = 0.25

<output2>
file_type = bin
variable  = rad_m1_F
dt        = 0.25
