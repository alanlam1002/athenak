# AthenaK input file for Task A4 unit test: mass conservation under the new generic
# area/volume-weighted flux-divergence kernel (src/mhd/mhd_update.cpp).
# Same rationale as tst/inputs/ut_hydro_mass_conservation.athinput, MHD version.

<comment>
problem   = mhd linear wave (mass-conservation unit test)

<job>
basename  = ut_mhd_mass_conservation

<mesh>
nghost    = 2
coord     = cartesian
nx1       = 16
x1min     = 0.0
x1max     = 3.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 1.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 8
x3min     = 0.0
x3max     = 1.5
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.1
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667
iso_sound_speed = 1.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
vy0       = 0.0
vz0       = 0.0
bx0       = 1.0
by0       = 1.4142136
bz0       = 0.5
along_x1  = false
along_x2  = false
along_x3  = false

<output1>
file_type = hst
dt        = 0.01
