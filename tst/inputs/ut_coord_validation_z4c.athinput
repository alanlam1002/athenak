# AthenaK input file: coordinate-validation smoke input, vacuum Z4c variant (D-009).
# No <hydro>/<mhd> and general_rel unset, so is_dynamical_relativistic is false; the
# Coordinates constructor must still reject <z4c> + curvilinear coord. With
# coord=cartesian (the default here) it must build the Mesh and exit at nlim=0.
# Same mesh as ut_coord_validation.athinput, which passes ValidateCoordGeneral() for
# cartesian, cylindrical and spherical_polar, so only the z4c guard can fire.

<comment>
problem   = coordinate-system input validation unit test, vacuum z4c

<job>
basename  = ut_coord_validation_z4c

<mesh>
nghost    = 2
coord     = cartesian
nx1       = 8
x1min     = 0.5
x1max     = 1.5
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 8
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<z4c>
diss       = 1

<problem>
pgen_name = z4c_linear_wave
amp       = 1.0e-8
kx1       = 1
kx2       = 0
kx3       = 0
