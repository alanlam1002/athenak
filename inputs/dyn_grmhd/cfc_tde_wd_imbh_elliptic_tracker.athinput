# TRACKING VARIANT of cfc_tde_wd_imbh_elliptic.athinput -- see
# go-to-athenak-tde-read-memoized-dusk.md plan (2026-09-14) and DEVELOPMENT.md
# items 38/39/42. Instead of a pre-drawn static disk covering the whole orbit,
# this fixture uses refinement=adaptive with a user-enrolled AMR criterion
# (RefineTOVTracker in dyngr_tov.cpp) that recenters the refined region on the
# star's CFC-computed mass centroid every cycle, analogous to z4c's
# CompactObjectTracker. GENUINE, CURRENTLY-UNFIXED RISK: refinement=adaptive
# means real per-cycle regridding, and items 38/39/42 document a still-open
# MeshBlock::SetNeighbors registration bug under irregular AMR topology --
# exactly why the production fixture deliberately avoids AMR. Validate at
# small scale before trusting this for any long production run.
#
# Otherwise identical to cfc_tde_wd_imbh_elliptic.athinput (see its own header
# for the orbit/velocity/mesh derivation) except: refinement=adaptive with a
# small seed region instead of the full static disk (see <refined_region1>
# below), and <problem>/<cfc> tracking-related keys.

<comment>
problem  = Elliptic-orbit TDE, TRACKING refinement variant (RefineTOVTracker) -- comparison run

<job>
basename = cfc_tde_wd_imbh_elliptic_tracker

<mesh>
# Same cubic power-of-2 root grid as the parent fixture (see its header for why):
# 128/16=8 root MeshBlocks/axis, multigrid root hierarchy halves cleanly to 1x1x1.
nghost = 4        # Number of ghost cells
nx1    = 128      # 8 MeshBlocks in x1-direction (root level), dx=1.0
x1min  = -64.0    # minimum x1
x1max  = 64.0     # maximum x1 -- orbit stays within +/-30, ample buffer beyond
ix1_bc = diode    # inner boundary -- full domain, no reflection symmetry
ox1_bc = diode    # outer boundary

nx2    = 128      # 8 MeshBlocks in x2-direction (root level), dx=1.0
x2min  = -64.0    # minimum x2
x2max  = 64.0     # maximum x2
ix2_bc = diode    # inner boundary
ox2_bc = diode    # outer boundary

nx3    = 128      # 8 MeshBlocks in x3-direction (root level), dx=1.0
x3min  = -64.0    # minimum x3
x3max  = 64.0     # maximum x3
ix3_bc = diode    # inner boundary
ox3_bc = diode    # outer boundary

<meshblock>
nx1  = 16        # must be a power of 2 (multigrid requirement)
nx2  = 16
nx3  = 16

<mesh_refinement>
refinement          = adaptive  # was static -- see header note on the SetNeighbors risk
max_nmb_per_rank    = 400
num_levels          = 5         # max_level=4, same as the static production fixture
refinement_interval = 1
ncycle_check        = 1         # check every cycle -- the star moves far less than
                                 # one level-4 block-width per cycle (v0=0.1357c *
                                 # dt~0.03), comfortably fast enough to keep up.

<amr_criterion0>
method = user           # dispatches to RefineTOVTracker (dyngr_tov.cpp), enrolled
                        # via <problem>/track_star_refinement=true below.

<refined_region1>
# Small SEED box at the star's t=0 position/radius (R_*=0.677), not the full disk
# the static fixture uses -- gives correct resolution at t=0, before
# RefineTOVTracker has a centroid to work from (<refined_regionN> is read once
# at startup; a cold AMR start would under-resolve the star for several cycles
# while levels ramp up one at a time). Tracker maintains/moves this box after.
level = 4        # dx = 1.0/2^4 = 0.0625 -> ~11 cells across the star
x1min = 27.0     # star_center +/- ~3 in x1/x2 (> R_*=0.677 + track_radius=4.0),
x1max = 33.0     # +/- 2 in x3 (matches the disk's own x3 half-thickness).
x2min = -3.0
x2max = 3.0
x3min = -2.0
x3max = 2.0

<time>
evolution  = dynamic    # dynamic/kinematic/static
gr_dt      = true
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = -1
tlim       = 500        # periapsis at t~349 M (not the parent's 145 M for radial
                         # infall) + ~150 M post-periapsis buffer to see debris
                         # dynamics begin. See header note on why 200 is not enough.
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false     # matches every off-center TOV fixture to date (item 46/48)

<mhd>
eos         = ideal      # EOS type
dyn_eos     = ideal      # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx       # spatial reconstruction method
rsolver     = hlle       # Riemann solver to be used
dfloor      = 1.0e-24    # atmosphere floor (as requested)
tfloor      = 1.0e-22    # matches the established 100x-above-dfloor ratio
dthreshold  = 1.02       # Threshold for flooring
gamma       = 1.6666666666666667  # 5/3, per the WD-like polytrope
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose = true
init_omega   = 1.0
# Same production-validated CFC solver settings as the parent fixture (see its
# header for the full measurement trail): mg_threshold/mg_poisson_threshold=1e-8,
# mg_poisson_mporder=2, mg_npresmooth/npostsmooth=2, mg_norm=rms (R3). Unrelated to
# the velocity boost -- accuracy of these settings is independent of star_vel_x2.
mg_threshold   = 1.0e-8
mg_poisson_threshold = 1.0e-8
mg_poisson_mporder = 2
mg_npresmooth  = 2
mg_npostsmooth = 2
mg_norm = rms
puncture_enabled = true
puncture_mass    = 1.0            # M_BH = 1e4 Msun, fixed at the coordinate origin
# alpha_floor: REQUIRED -- default 0.0 clamps a negative lapse to EXACTLY zero,
# causing a 1/alpha singularity/NANS_IN_CONS cascade near the puncture (item 59).
alpha_floor = 1.0e-6
# solve_interval: same production-validated cadence as the static-region fixture
# (DEVELOPMENT.md item 61/62) -- 3.65x speedup, negligible accuracy cost. Note
# pcfc->r_com_mass_ (what RefineTOVTracker reads) only refreshes every 10th
# cycle, lagging the true centroid by at most a fraction of a block-width.
solve_interval = 10
<problem>
isotropic   = true      # required: CFC solves for the isotropic-gauge metric AND
                         # is required by star_vel_x1/2/3 (see dyngr_tov.cpp)
rhoc        = 3.24e-4   # converted from 3.24e-12 (Msun=1 units) via lambda^2
kappa       = 1.2346626297e-2  # converted from 2.66e3 (Msun=1 units) via lambda^(-4/3)
npoints     = 10000.0   # buffer points for TOV calculation
dr          = 2e-4      # npoints*dr = 2.0, ~3x the star's own R_*=0.677
b_norm      = 0.0       # unmagnetized
pcut        = 1e-6
magindex    = 1
star_center_x1 = 30.0    # ~1.83x the tidal radius (r_t=16.4) -- release point
star_center_x2 = 0.0     # puncture always fixed at the origin
star_center_x3 = 0.0
star_vel_x1    = 0.0     # ELLIPTIC ORBIT: purely tangential kick at release (see
star_vel_x2    = 0.135657  # header). Solved for periapsis(areal)=10.0 r_g via
star_vel_x3    = 0.0     # scripts/tde_elliptical_orbit_ic.py; both closed-form and
                         # full ODE cross-check agree to <0.0001 r_g.
user_hist   = true       # enrolls TOVHistory (rho-max, alpha-min)
track_star_refinement = true   # enrolls RefineTOVTracker as user_ref_func -- THE
                                # feature this fixture exists to test.
track_radius = 4.0             # flag any MeshBlock within this distance of
                                # pcfc->r_com_mass_ for refinement; larger than
                                # R_*=0.677 plus a buffer for the centroid's lag
                                # between solve_interval-gated updates.

<output1>
file_type   = hst      # History data dump -- mass/momentum/energy conservation check
dt          = 0.1
data_format = %20.15e

<output2>
file_type   = bin      # Binary output -- psi/alpha near the puncture and star
variable    = adm
dt          = 1.0      # ~500 dumps over tlim=500 (NOT dcycle=1: far too many)
slice_x3    = 0.0
id = adm_xy

<output3>
file_type   = bin      # Binary output -- density, to follow the star and its debris
variable    = mhd_w_bcc
dt          = 1.0
slice_x3    = 0.0
id = prim_xy

<output4>
file_type   = rst      # Restart dumps -- ~29,000 cycles (2.5x the parent's
dcycle      = 1000     # ~11,600) will not finish in one allocation.
