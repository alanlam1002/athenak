<comment>
problem = Radiation diffusion test, parameters matched to
  inputs/tests/rad_m1_photon_diffusion.athinput for a cross-check between the
  discrete-ordinate (this module) and grey M1 diffusion tests. kappa_s=5 case
  (matches the M1 test's first, non-stiff-source-branch attempt).

<job>
basename = diffusion_kappa5  # name of run

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integration algorithm
cfl_number = 0.4      # matched to the M1 cross-check run
nlim       = -1       # cycle limit
tlim       = 5.0      # time limit -- matches M1's first (kappa_s=5) attempt

<coord>
general_rel = true    # w/ general relativity
minkowski = true      # Minkowski flag

<mesh>
nghost = 2
nx1    = 128       # matches the M1 cross-check run's resolution
x1min  = -6.0      # matches the M1 cross-check run's domain
x1max  = 6.0
ix1_bc = periodic  # inner-X1 boundary flag
ox1_bc = periodic  # outer-X1 boundary flag

nx2    = 1         # Number of zones in X2-direction
x2min  = -0.5      # minimum value of X2
x2max  = 0.5       # maximum value of X2
ix2_bc = periodic  # inner-X2 boundary flag
ox2_bc = periodic  # outer-X2 boundary flag

nx3    = 1         # Number of zones in X3-direction
x3min  = -0.5      # minimum value of X3
x3max  = 0.5       # maximum value of X3
ix3_bc = periodic  # inner-X3 boundary flag
ox3_bc = periodic  # outer-X3 boundary flag

<hydro>
eos         = ideal  # EOS type
reconstruct = plm    # spatial reconstruction method
rsolver     = hlle   # Riemann-solver to be used
gamma       = 2.0    # ratio of specific heats Gamma

<radiation>
nlevel = 2               # number of levels for geodesic mesh
fixed_fluid = true       # disable hydro evolution
affect_fluid = false     # coupling to fluid
arad = 1.0               # radiation constant
kappa_s = 5.0            # scattering opacity -- matches M1 cross-check run
kappa_a = 0.0            # absorption opacity
kappa_p = 0.0            # planck minus rosseland opacity

<problem>
v1 = 0.0   # static medium, matching the M1 cross-check run
nu = 3.0   # sets width of initial Gaussian: exp(-nusq xsq); nu=3 => sigma0^2=1/18,
          # matching M1's E=exp(-9x^2) IC exactly

<output1>
file_type   = tab          # output format
variable    = rad_fluid    # choice of variables to output
dt          = 0.5          # output cadence, matches the M1 cross-check run
