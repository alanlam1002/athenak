# Athena++ (Kokkos version) input file: excision validation for the CFC BH-puncture
# extension (CFC_PUNCTURE_TDE_PLAN.md Sec 5 Phase B item 9). Identical in every other
# respect to cfc_puncture_offcenter_tov.athinput (item 46's already-validated
# excise=false regression baseline) -- this is a controlled single-variable change
# (excision on vs. off) so any difference in behavior is attributable to excision
# alone, not to anything else.
#
# <coord> excise=true, excision_scheme=lapse, excise_lapse=0.25: turns on the plan
# doc's own recommended scheme (never yet exercised in ANY fixture in this repo --
# grep confirms no existing dyn_grmhd fixture, CFC or otherwise, sets excise=true; the
# whole is_dynamical_relativistic + excision code path is untested prior to this run).
# excise_lapse=0.25 is the code's own default and was already numerically checked in
# the plan doc: alpha0=0.25 at r_iso~0.59 M_BH, comfortably inside the horizon
# (r_iso~0.78 M_BH) -- no retuning needed for a first test.
#
# dexcise=1.0e-10, texcise=1.0e-8: set equal to this fixture's own dfloor/tfloor
# (below), so the excised region is simply reset to "floor" conditions -- the
# simplest, easiest-to-reason-about choice for a first test, not a new floor scale.
#
# <mesh_refinement>: a first attempt at this fixture without any refinement (dx=1.6
# root resolution) found that the nearest actual grid-cell center to the origin sits
# at r~1.386 (=0.8*sqrt(3), since the root grid has a cell FACE exactly at x=0),
# where alpha~0.499 -- ZERO grid cells anywhere have alpha<0.25 at that resolution, so
# excision never actually activates and a "no difference" result would be vacuous.
# Static refinement puts real cells inside the excision sphere (r_iso~0.59 M_BH): at
# level L, the nearest cell-center distance is (dx_root/2^(L+1))*sqrt(3); solving for
# r_min<0.59 gives L>=2 (dx=0.4, r_min=0.3465). A first attempt at level=4 (matching
# cfc_bu8_offcenter.athinput's own choice for resolving the star, dx=0.1) produced
# 1084 MeshBlocks in Serial (proper-nesting buffer growth over 4 levels) and was too
# slow for a quick local smoke test -- level=2 is the minimal depth that still
# guarantees excised cells, at far lower cost. The region straddles x=0 symmetrically
# (-3.2 to 3.2 on all three axes) because the origin sits exactly on the corner where
# the root grid's MeshBlocks meet (x1/x2/x3 all split there), not inside a single one.
# See cfc_puncture_offcenter_tov_refined_noexcise.athinput for the resolution-matched
# excise=false control this fixture is compared against (not item 46's original
# unrefined baseline, to keep the excision-on/off comparison single-variable).
#
# Expectation: since the excised region (r_iso~0.59 M_BH, tiny) sits far inside where
# the star's own matter ever reaches (star_center_x1=60, R_iso~11.82), this should be
# a no-op for the star's physics -- rho-max/alpha-min/mass conservation/centroid
# tracking should match the refined_noexcise control's results. That expectation is
# exactly what this fixture is meant to test, not assume.

<comment>
problem  = Excision validation for CFC BH-puncture (Sec 5 Phase B item 9)

<job>
basename = cfc_puncture_offcenter_tov_excision

<mesh>
nghost = 4        # Number of ghost cells
nx1    = 80       # 5 MeshBlocks in x1-direction (root level), dx=1.6
x1min  = -25.6    # minimum x1 -- BH puncture at x=0 sits one MeshBlock in from here
x1max  = 102.4    # maximum x1 -- star surface (~71.8) has ~19 cells of buffer before here
ix1_bc = diode    # inner boundary -- NOT reflect (star is off-center, no mirror parity)
ox1_bc = diode    # outer boundary

nx2    = 32       # 2 MeshBlocks in x2-direction (root level), dx=1.6
x2min  = -25.6    # minimum x2
x2max  = 25.6     # maximum x2
ix2_bc = diode    # inner boundary
ox2_bc = diode    # outer boundary

nx3    = 32       # 2 MeshBlocks in x3-direction (root level), dx=1.6
x3min  = -25.6    # minimum x3
x3max  = 25.6     # maximum x3
ix3_bc = diode    # inner boundary
ox3_bc = diode    # outer boundary

<meshblock>
nx1  = 16        # must be a power of 2 (multigrid requirement)
nx2  = 16
nx3  = 16

<mesh_refinement>
refinement          = static
max_nmb_per_rank    = 200
num_levels          = 3
refinement_interval = 1

<refined_region1>
level = 2        # finest level; dx = 1.6/2^2 = 0.4 -- minimal depth that still puts a
                  # cell center (r_min=0.3465) inside the excision sphere (r_iso~0.59)
x1min = -3.2     # straddles the origin symmetrically -- x=0 sits on a root-MeshBlock
x1max = 3.2      # corner (x1/x2/x3 all split there), not inside a single block
x2min = -3.2
x2max = 3.2
x3min = -3.2
x3max = 3.2

<time>
evolution  = dynamic    # dynamic/kinematic/static
gr_dt      = true
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = -1
tlim       = 100        # matches item 46's own baseline run length
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel     = true      # general relativity
m               = 1.0
a               = 0.0
excise          = true      # Phase B item 9 -- the one change versus item 46's baseline
excision_scheme = lapse      # plan doc's own recommended scheme
excise_lapse    = 0.25       # code default, already numerically justified in the plan doc
dexcise         = 1.0e-10   # matches this fixture's own dfloor
texcise         = 1.0e-8    # matches this fixture's own tfloor

<mhd>
eos         = ideal      # EOS type
dyn_eos     = ideal      # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx       # spatial reconstruction method (matches cfc_puncture_vacuum*)
rsolver     = hlle       # Riemann solver to be used
dfloor      = 1.0e-10    # floor on density rho (matches cfc_puncture_vacuum*)
tfloor      = 1.0e-8
dthreshold  = 1.02       # Threshold for flooring
gamma       = 2.0        # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose = true
init_omega   = 1.0
mg_threshold   = 1.0e-10  # matches cfc_bu8_stability's genuine-dynamical-run setting
mg_poisson_threshold = 1.0e-10
mg_npresmooth  = 3
mg_npostsmooth = 3
puncture_enabled = true
puncture_mass    = 1.0            # M_BH, fixed at the coordinate origin x=0

<problem>
isotropic   = true      # required: CFC solves for the isotropic-gauge metric
rhoc        = 1.28e-4   # matches cfc_puncture_vacuum_small.athinput -- gives
                         # isotropic radius R_iso~11.82 for this kappa/gamma
kappa       = 100.0     # P = kappa*rho^gamma
npoints     = 10000.0   # buffer points for TOV calculation
dr          = 1e-2      # radial step for TOV calculation
b_norm      = 0.0       # unmagnetized
pcut        = 1e-6
magindex    = 1
star_center_x1 = 60.0    # ~5x R_iso -- the star's actual center, away from the BH
star_center_x2 = 0.0     # puncture (always fixed at x=0)
star_center_x3 = 0.0
user_hist   = true       # enrolls TOVHistory (rho-max, alpha-min)

<output1>
file_type   = hst      # History data dump -- mass/momentum/energy conservation check
dt          = 1.0
data_format = %20.15e

<output2>
file_type   = bin      # Binary output -- inspect psi/alpha near the puncture and star
variable    = adm
dcycle      = 25
slice_x3    = 0.0
id = adm_xy

<output3>
file_type   = bin      # Binary output -- inspect density near the star for stability
variable    = mhd_w_bcc
dcycle      = 25
slice_x3    = 0.0
id = prim_xy
