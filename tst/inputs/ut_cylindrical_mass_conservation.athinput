# AthenaK input file for Task B4 (conservation half) unit test: mass conservation for
# the cylindrical (R,phi,z) area/volume-weighted flux divergence (Tasks A3/B1) on a
# genuinely curvilinear grid. Closed domain: reflecting at both radial boundaries
# (annulus, R in [1,2], avoiding the R=0 origin -- that case is covered by the
# cylindrical_axisym test below), periodic in phi, periodic in z. A reflecting-wall
# Riemann-solver flux has exactly zero mass flux through that face (standard property),
# and periodic phi/z faces cancel pairwise, so total mass must be conserved to roundoff
# regardless of the (arbitrary, non-symmetric) shock-tube initial condition used to
# drive genuine dynamics.

<comment>
problem   = shock tube in a cylindrical annulus (mass-conservation unit test)

<job>
basename  = ut_cylindrical_mass_conservation

<mesh>
nghost    = 2
coord     = cylindrical
nx1       = 16
x1min     = 1.0
x1max     = 2.0
ix1_bc    = reflect
ox1_bc    = reflect

nx2       = 8
x2min     = 0.0
x2max     = 6.283185307179586
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 4
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<mesh_refinement>
refinement = none

<meshblock>
nx1       = 16
nx2       = 8
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 0.05
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.4

<problem>
pgen_name = shock_tube
shock_dir  = 1
xshock     = 1.5

dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0

dr = 0.6
pr = 0.5
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = hst
dt        = 0.005
