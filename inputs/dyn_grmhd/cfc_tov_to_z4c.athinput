# AthenaK (Kokkos version) input file: CFC -> Z4c in-run handoff test.
#
# A stable, non-rotating TOV star (K = 100, Gamma = 2, rhoc = 1.28e-3, M ~ 1.4,
# 2M/R ~ 0.29) in a full box. The metric is solved with CFC (<cfc>, maximal slicing,
# minimal distortion) until <cfc>/handoff_time; the CFC slice then becomes the
# initial data of a Z4c evolution (1+log lapse, Gamma-driver shift) and the run
# continues as a native Z4c run. See src/cfc/DEVELOPMENT.md item 64.
#
# Full box, no reflecting faces: on this branch CFC's multigrid stalls (defect ratio
# -> 1) on an octant with reflect inner boundaries, while the full box converges.
#
# Build: cmake -DPROBLEM=dyn_grmhd/dyngr_tov ...
# What to check: the handoff banner (round-trip and constraint norms), rho-max and
# alpha-min in cfc_tov_to_z4c.user.hst across t = handoff_time, and the Z4c
# constraint norms in cfc_tov_to_z4c.z4c.hst (written from the handoff on) against a
# native Z4c run of the same star (the same deck with <cfc> removed and <z4c> kept).
#
# <z4c> is read only at the handoff; while CFC is active Z4c is not allocated. A
# restart written after the handoff restarts as a native Z4c run.

<comment>
problem  = CFC -> Z4c handoff, stable TOV star (full box)

<job>
basename = cfc_tov_to_z4c

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 128     # number of cells in x1-direction
x1min  = -32.0   # minimum x1
x1max  = 32.0    # maximum x1
ix1_bc = diode   # inner boundary
ox1_bc = diode   # outer boundary
nx2    = 128     # number of cells in x2-direction
x2min  = -32.0   # minimum x2
x2max  = 32.0    # maximum x2
ix2_bc = diode   # inner boundary
ox2_bc = diode   # outer boundary
nx3    = 128     # number of cells in x3-direction
x3min  = -32.0   # minimum x3
x3max  = 32.0    # maximum x3
ix3_bc = diode   # inner boundary
ox3_bc = diode   # outer boundary

<meshblock>
nx1  = 32        # CFC's multigrid requires a power-of-two MeshBlock size
nx2  = 32
nx3  = 32

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk3        # time integration algorithm
cfl_number = 0.25
nlim       = -1
tlim       = 500
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false

<mhd>
eos         = ideal     # EOS type
dyn_eos     = ideal     # EOS type
dyn_error   = reset_floor # error policy
reconstruct = wenoz     # spatial reconstruction method
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.0e-10   # floor on density rho
tfloor      = 1.0e-8
dthreshold  = 1.02      # Threshold for flooring
gamma       = 2.0       # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose   = true
mg_threshold   = 1.0e-10
mg_poisson_threshold = 1.0e-10
handoff        = true   # switch the spacetime solver from CFC to Z4c once
handoff_time   = 50.0   # switch at the end of the first cycle with t >= 50 (<0: off)
handoff_cycle  = -1     # or at the end of this cycle (0: at initialization; <0: off)
handoff_alpha_min   = -1.0  # automatic: switch if min(alpha) < this (<=0: off)
handoff_cf_residual = -1.0  # automatic: switch if the conformal-flatness residual
                            # ||(L_beta gamma)^TF_ij - 2 alpha K_ij|| / ||2 alpha K_ij||
                            # (RMS; CFC sets d_t of the conformal metric to zero, this
                            # is how far its alpha, beta, K_ij are from doing so)
                            # exceeds this (<=0: off)
handoff_cf_floor = 1.0e-10  # floor on the denominator (static spacetimes have K = 0)
handoff_check_dcycle = 1    # cycles between automatic-criterion checks
handoff_resolve = true  # re-solve CFC on the final conserved state before switching
handoff_output  = true  # write every output just before and just after the switch
handoff_verbose = false # print the automatic criteria at every check

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 0.3
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1e-05
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
rhoc        = 1.28e-3  # Central density
kappa       = 100.0    # P = kappa*rho^gamma
npoints     = 10000.0  # buffer points for TOV calculation
dr          = 1e-3     # radial step for TOV calculation
isotropic   = true     # isotropic coordinates: conformally flat initial data
b_norm      = 0.0
pcut        = 1e-6
magindex    = 1
user_hist   = true

<output1>
file_type   = rst
dt          = 100.0

<output2>
file_type   = hst      # History data dump
dt          = 1.0      # time increment between outputs
data_format = %20.15e

<output3>
file_type   = bin      # Binary output
variable    = mhd_w
dt          = 25.0
slice_x3    = 0.0
id          = prim_xy

<output4>
file_type   = bin
variable    = adm
dt          = 25.0
slice_x3    = 0.0
id          = adm_xy

<output5>
file_type   = bin      # written from the handoff on (needs Z4c)
variable    = con
dt          = 25.0
slice_x3    = 0.0
id          = con_xy
