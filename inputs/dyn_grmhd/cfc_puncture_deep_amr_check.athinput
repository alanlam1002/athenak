# Athena++ (Kokkos version) input file: isolated deep (7-9 level) static AMR smoke
# test for the CFC BH-puncture solver (CFC_PUNCTURE_TDE_PLAN.md Phase B item 10
# prep). The realistic TDE setup (1e5 Msun BH, 0.7 Msun/~1e4 km WD-like TOV star at
# x=20 r_g) needs the star's own radius (~0.069 code units, converting from the
# physical R~1e4 km) resolved with ~16-32 cells across its diameter while the domain
# spans well past 20 r_g -- requiring ~7-9 levels of static refinement, well beyond
# the 5 levels this project has ever validated (item 12/45-51). Per user's explicit
# choice, this fixture validates that AMR depth in ISOLATION (near-vacuum matter, same
# negligible-mass trick as cfc_puncture_vacuum.athinput) before building the actual
# combined TDE fixture, so any problem found here is cleanly attributable to AMR
# depth itself, not the new extreme-mass-ratio star.
#
# Full (non-octant-symmetric) domain, diode BCs on all 6 faces -- deliberately NOT
# reusing cfc_puncture_vacuum.athinput's own reflecting-octant domain, to avoid
# exercising the still-open (but out of scope) reflecting-boundary corner-read gap
# (item 50, ApplyPhysicalBoundariesOctet) at the same time as this AMR-depth test.
#
# Root dx=1.0: x1 in [-20,60] (nx1=80, 5 MeshBlocks of 16), x2/x3 in [-24,24]
# (nx2=nx3=48, 3 MeshBlocks of 16 each). Chosen so x1=20 (the real star's future
# position) sits at the CENTER of the MeshBlock spanning [12,28], and x2=x3=0 sits at
# the center of the MeshBlock spanning [-8,8] -- the refined region below is confined
# entirely inside a single root MeshBlock on every axis, safely away from any
# MeshBlock corner/face boundary (this session already hit a 1084-MeshBlock
# proper-nesting blowup once when a refined region straddled a corner at the origin;
# this domain is specifically laid out to avoid that failure mode here).
#
# <refined_region1> level=8: dx=1/2^8=0.00390625, comfortably resolving the future
# star's R~0.069 (~35 cells across the diameter) with buffer room (region spans
# x1 in [18,22], x2/x3 in [-2,2], i.e. +/-2 around the target point, ~29x the star's
# own radius of margin).
#
# Matter: same near-vacuum trick as cfc_puncture_vacuum.athinput (rhoc pushed well
# below puncture_mass's own scale, star left at the default origin-centered position
# since only the coordinate point x=20 -- not any real matter -- is being tested
# here). nlim=0: this stage checks CFC::InitializeMetric's own initial solve and the
# resulting MeshBlock count/mesh structure, not real evolution.

<comment>
problem  = Isolated deep static-AMR smoke test for CFC BH-puncture (Phase B item 10 prep)

<job>
basename = cfc_puncture_deep_amr_check

<mesh>
nghost = 4        # Number of ghost cells
nx1    = 80       # 5 MeshBlocks in x1-direction (root level), dx=1.0
x1min  = -20.0    # minimum x1
x1max  = 60.0     # maximum x1 -- future star position (x=20) centered in one MeshBlock
ix1_bc = diode    # inner boundary -- full domain, no reflection symmetry
ox1_bc = diode    # outer boundary

nx2    = 48       # 3 MeshBlocks in x2-direction (root level), dx=1.0
x2min  = -24.0    # minimum x2
x2max  = 24.0     # maximum x2
ix2_bc = diode    # inner boundary
ox2_bc = diode    # outer boundary

nx3    = 48       # 3 MeshBlocks in x3-direction (root level), dx=1.0
x3min  = -24.0    # minimum x3
x3max  = 24.0     # maximum x3
ix3_bc = diode    # inner boundary
ox3_bc = diode    # outer boundary

<meshblock>
nx1  = 16        # must be a power of 2 (multigrid requirement)
nx2  = 16
nx3  = 16

<mesh_refinement>
refinement          = static
max_nmb_per_rank    = 200
num_levels          = 9
refinement_interval = 1

<refined_region1>
level = 8        # finest level; dx = 1.0/2^8 = 0.00390625
x1min = 19.9     # a first (too large) +/-2 region at level=8 produced 280290
x1max = 20.1     # MeshBlocks (262144 at the finest level alone) -- each level's
x2min = -0.1     # MeshBlock covers 16*dx physical units, which SHRINKS by 2x per
x2max = 0.1      # level, so a fixed-size region's MeshBlock count grows 2x per
x3min = -0.1     # level too. Tightened to +/-0.1 (width=0.2, ~1.5x the star's own
x3max = 0.1      # diameter of 0.138) -- ~3-4 MeshBlocks per dimension at the finest
                  # level, mirroring the tight-region convention that kept the
                  # level=2 excision test's own MeshBlock count low.

<time>
evolution  = dynamic    # dynamic/kinematic/static
gr_dt      = true
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = 0          # this stage checks initial-data construction/mesh structure
tlim       = -1.0       # only, not real evolution
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false     # excision already validated separately (item 9); not needed here

<mhd>
eos         = ideal      # EOS type
dyn_eos     = ideal      # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx       # spatial reconstruction method (matches cfc_puncture_vacuum*)
rsolver     = hlle       # Riemann solver to be used
dfloor      = 1.0e-10    # floor on density rho (matches cfc_puncture_vacuum*)
tfloor      = 1.0e-8
dthreshold  = 1.02       # Threshold for flooring
gamma       = 2.0        # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose = true
init_omega   = 1.0
mg_threshold = 1.0e-10
puncture_enabled = true
puncture_mass    = 1.0            # M_BH, fixed at the coordinate origin x=0

<problem>
isotropic   = true      # required: CFC solves for the isotropic-gauge metric
rhoc        = 1.28e-4   # matches cfc_puncture_vacuum.athinput -- negligible
                         # mass/stress-energy compared to puncture_mass; only the
                         # coordinate point x=20 (not any real matter) is under test
kappa       = 100.0     # P = kappa*rho^gamma
npoints     = 10000.0   # buffer points for TOV calculation
dr          = 1e-2      # radial step for TOV calculation
b_norm      = 0.0       # unmagnetized
pcut        = 1e-6
magindex    = 1
user_hist   = true

<output1>
file_type   = hst      # History data dump -- mass/momentum/energy conservation check
dt          = 0.0
dcycle      = 1
data_format = %20.15e

<output2>
file_type   = bin      # Binary output -- inspect psi/alpha near the puncture and the
variable    = adm      # refined region at x=20
dcycle      = 1
slice_x3    = 0.0
id = adm_xy
