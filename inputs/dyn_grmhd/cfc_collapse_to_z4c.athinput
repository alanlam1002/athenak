# AthenaK (Kokkos version) input file: CFC -> Z4c handoff on an automatic trigger.
#
# A TOV star on the unstable branch (K = 100, Gamma = 2, rhoc = 8e-3, M ~ 1.45,
# R_iso ~ 4.27; the "SU" model of Cordero-Carrion et al. 2009) is pushed towards
# collapse by an inward velocity perturbation. The metric is solved with CFC (maximal
# slicing, minimal distortion) while the star contracts; once min(alpha) drops below
# <cfc>/handoff_alpha_min the CFC slice becomes the initial data of a Z4c evolution
# (1+log lapse, Gamma-driver shift), which carries the collapse on. Matter inside the
# lapse-based excision region (alpha < <coord>/excise_lapse) is excised; the excision
# lapse is below the trigger, so nothing is excised while CFC is active.
# See src/cfc/DEVELOPMENT.md item 64.
#
# Build: cmake -DPROBLEM=dyn_grmhd/dyngr_tov ...
# What to check: the handoff banner (trigger time, round trip, constraint norms),
# rho-max and alpha-min in cfc_collapse_to_z4c.user.hst across the switch, and the
# Z4c constraint norms in cfc_collapse_to_z4c.z4c.user.hst against a native Z4c run
# of the same star (the same deck with <cfc> removed and <z4c> kept).
#
# init_freeze_conserved: CFC's iterated t = 0 solve does not converge to the right
# conformal factor for a star this compact (DEVELOPMENT.md items 22, 24, 29).

<comment>
problem  = CFC -> Z4c handoff on min(alpha), collapsing unstable TOV star

<job>
basename = cfc_collapse_to_z4c

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 256     # number of cells in x1-direction
x1min  = -32.0   # minimum x1
x1max  = 32.0    # maximum x1
ix1_bc = diode   # inner boundary
ox1_bc = diode   # outer boundary
nx2    = 256     # number of cells in x2-direction
x2min  = -32.0   # minimum x2
x2max  = 32.0    # maximum x2
ix2_bc = diode   # inner boundary
ox2_bc = diode   # outer boundary
nx3    = 256     # number of cells in x3-direction
x3min  = -32.0   # minimum x3
x3max  = 32.0    # maximum x3
ix3_bc = diode   # inner boundary
ox3_bc = diode   # outer boundary

<meshblock>
nx1  = 32        # CFC's multigrid requires a power-of-two MeshBlock size
nx2  = 32
nx3  = 32

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk3        # time integration algorithm
cfl_number = 0.25
nlim       = -1
tlim       = 150
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = true
excision_scheme = lapse # excise where alpha < excise_lapse (refreshed by Z4c)
excise_lapse = 0.05     # keep below <cfc>/handoff_alpha_min
dexcise     = 1.0e-10   # density inside excision
texcise     = 1.0e-8    # temperature inside excision

<mhd>
eos         = ideal     # EOS type
dyn_eos     = ideal     # EOS type
dyn_error   = reset_floor # error policy
reconstruct = wenoz     # spatial reconstruction method
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.0e-10   # floor on density rho
tfloor      = 1.0e-8
dthreshold  = 1.02      # Threshold for flooring
gamma       = 2.0       # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<cfc>
init_verbose   = true
init_freeze_conserved = true   # one-shot t = 0 solve (compact star)
init_use_psi5_source  = false  # required by init_freeze_conserved
mg_threshold   = 1.0e-10
mg_poisson_threshold = 1.0e-10
handoff        = true   # switch the spacetime solver from CFC to Z4c once
handoff_time   = -1.0   # no fixed switch time (<0: off)
handoff_cycle  = -1     # no fixed switch cycle (<0: off)
handoff_alpha_min   = 0.2   # automatic: switch if min(alpha) < this (<=0: off)
handoff_cf_residual = -1.0  # automatic: conformal-flatness residual (<=0: off)
handoff_check_dcycle = 1    # cycles between automatic-criterion checks
handoff_resolve = true  # re-solve CFC on the final conserved state before switching
handoff_output  = true  # write every output just before and just after the switch
handoff_verbose = false # print the automatic criteria at every check

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 0.3
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1e-05
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
rhoc        = 8.0e-3   # Central density (unstable branch; max mass at ~3.2e-3)
kappa       = 100.0    # P = kappa*rho^gamma
npoints     = 10000.0  # buffer points for TOV calculation
dr          = 1e-3     # radial step for TOV calculation
isotropic   = true     # isotropic coordinates: conformally flat initial data
v_pert      = -0.05    # radial velocity 0.5*v_pert*(3x - x^3), x = r/R (<0: inward)
b_norm      = 0.0
pcut        = 1e-6
magindex    = 1
user_hist   = true

<output1>
file_type   = rst
dt          = 25.0

<output2>
file_type   = hst      # History data dump
dt          = 0.5      # time increment between outputs
data_format = %20.15e

<output3>
file_type   = bin      # Binary output
variable    = mhd_w
dt          = 5.0
slice_x3    = 0.0
id          = prim_xy

<output4>
file_type   = bin
variable    = adm
dt          = 5.0
slice_x3    = 0.0
id          = adm_xy

<output5>
file_type   = bin      # written from the handoff on (needs Z4c)
variable    = con
dt          = 5.0
slice_x3    = 0.0
id          = con_xy
